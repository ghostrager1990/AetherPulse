<UserControl x:Class="AppUI.Views.LiveDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             FontFamily="Bahnschrift"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:LiveDashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <StackPanel Margin="0,0,0,20">
                <!-- Row 1: Engine Title & Subtitle -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Engine Status &amp; Configuration Overview"/>
                    <TextBlock FontSize="12" Foreground="#888899" Margin="0,4,0,0" Text="DirectX 12 SwapChain Presentation Pacing &amp; Hardware Cadence Synchronization Pipeline."/>
                </StackPanel>

                <!-- Row 2: Dedicated Control Toolbar (Below Header) -->
                <Border Background="#12141A" BorderBrush="#222530" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Target Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="#888899" Margin="0,0,8,0" Text="Target Process:" VerticalAlignment="Center"/>
                            <ComboBox Height="30" ItemsSource="{Binding TargetProcesses}" MinWidth="190" SelectedItem="{Binding SelectedTargetProcess, Mode=TwoWay}" Style="{StaticResource DarkComboBox}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: Lock Badge & Injection Status -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A73E8" CornerRadius="6" Margin="0,0,8,0" Padding="10,4">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding SelectedTargetProcess, StringFormat='LOCKED TO: {0}'}"/>
                            </Border>

                            <Border Background="#1C1E24" BorderBrush="#2C2F38" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Stroke="{Binding PacingIndicatorColor}" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E0" Text="{Binding InjectionStatusText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Metrics Cards Grid -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Current FPS Card -->
                <Border Grid.Column="0" Background="#161A22" BorderBrush="{Binding MetricCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE FRAMERATE" FontSize="11.5" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding FpsDisplay}" FontSize="24" FontWeight="Bold" Foreground="#00FFCC" Margin="0,6,0,3" />
                        <TextBlock Text="Instant Present Cadence" FontSize="11.5" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- Frame Timing Card -->
                <Border Grid.Column="1" Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="FRAME TIMING" FontSize="11.5" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding FrametimeDisplay}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,3" />
                        <TextBlock Text="D3D12 High-Res Waitable Timer" FontSize="11.5" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- 1% Low FPS Card -->
                <Border Grid.Column="2" Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="1% LOW FPS" FontSize="11.5" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding OnePercentLowDisplay}" FontSize="24" FontWeight="Bold" Foreground="#3FB950" Margin="0,6,0,3" />
                        <TextBlock Text="Smooth Delivery Floor" FontSize="11.5" Foreground="#8B949E" />
                    </StackPanel>
                </Border>

                <!-- Pacing Jitter Card -->
                <Border Grid.Column="3" Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PACING JITTER" FontSize="11.5" FontWeight="Bold" Foreground="#8B949E" />
                        <TextBlock Text="{Binding JitterDisplay}" FontSize="24" FontWeight="Bold" Foreground="#3FB950" Margin="0,6,0,3" />
                        <TextBlock Text="Cadence Variance (&lt; 1.0% Target)" FontSize="11.5" Foreground="#8B949E" />
                    </StackPanel>
                </Border>
            </Grid>

                        <!-- Active D3D12 Standalone Pacing Pipeline -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,22" Padding="20">
                <StackPanel>
                    <TextBlock Text="Active DirectX 12 Presentation Pacing Core" FontSize="15.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />

                    <!-- Two-Column Balanced Pacing & Telemetry Card -->
                    <Border Background="#0D1117" BorderBrush="{Binding PacingBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Core Architecture & Badges -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="⚡" Foreground="#58A6FF" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Standalone DXGI Presentation Hook &amp; Cadence Engine" FontWeight="Bold" FontSize="14" Foreground="#58A6FF" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="9" Height="9" Stroke="{Binding PacingIndicatorColor}" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PacingPipelineStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </StackPanel>

                                <TextBlock Text="• High-resolution waitable timer synchronization (CREATE_WAITABLE_TIMER_HIGH_RESOLUTION)" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="• Sub-interval cadence alignment for smooth frame pacing delivery (50:50 ratio)" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="• Hardware present-queue synchronization, jitter smoothing, and zero-delay RTSS bypass" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <UniformGrid Columns="3" HorizontalAlignment="Left">
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="CADENCE MODE" FontSize="9" Foreground="#8B949E" FontWeight="SemiBold"/>
                                            <TextBlock Text="Precision 1X / 2X" FontSize="11" Foreground="#58A6FF" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="VARIANCE FLOOR" FontSize="9" Foreground="#8B949E" FontWeight="SemiBold"/>
                                            <TextBlock Text="&lt; 0.05ms Target" FontSize="11" Foreground="#3FB950" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                        <StackPanel>
                                            <TextBlock Text="INJECTION STATUS" FontSize="9" Foreground="#8B949E" FontWeight="SemiBold"/>
                                            <TextBlock Text="Standalone dxgi.dll" FontSize="11" Foreground="#E3B341" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Right Column: Live Hardware Telemetry Matrix -->
                            <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LIVE HARDWARE TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12" />
                                    
                                    <!-- Metric 1: Sub-Frame Variance -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sub-Frame Variance" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SubFrameVarianceStr}" FontSize="12" FontWeight="Bold" Foreground="#3FB950" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Metric 2: Frame Interval Delta -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Present Interval Delta" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PresentDeltaStr}" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Metric 3: Waitable Timer State -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Waitable Timer State" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimerStateStr}" FontSize="12" FontWeight="Bold" Foreground="#E3B341" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Metric 4: IPC Ring Buffer -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="IPC Shared Memory" FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IpcLinkStr}" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border><!-- System Environment Specifications -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel>
                    <TextBlock Text="System Environment Specifications" FontSize="15.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Text="Graphics Card" FontSize="11.5" Foreground="#8B949E" />
                            <TextBlock Text="{Binding GpuName}" FontSize="14" FontWeight="Bold" Foreground="#FF6E6E" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Dedicated VRAM" FontSize="11.5" Foreground="#8B949E" />
                            <TextBlock Text="{Binding DedicatedVram}" FontSize="14" FontWeight="Bold" Foreground="#7EE787" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Col 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                            <TextBlock Text="Display Adapter Driver" FontSize="11.5" Foreground="#8B949E" />
                            <TextBlock Text="{Binding DriverVersion}" FontSize="14" FontWeight="Bold" Foreground="#E3B341" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Primary Display Mode" FontSize="11.5" Foreground="#8B949E" />
                            <TextBlock Text="{Binding PrimaryDisplayMode}" FontSize="14" FontWeight="Bold" Foreground="#D2A8FF" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Col 2 -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Text="Processor (CPU)" FontSize="11.5" Foreground="#8B949E" />
                            <TextBlock Text="{Binding CpuName}" FontSize="14" FontWeight="Bold" Foreground="#58A6FF" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="DirectX API &amp; Core Health" FontSize="11.5" Foreground="#8B949E" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="9" Height="9" Stroke="{Binding CoreHealthColor}" StrokeThickness="1.5" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CoreHealthStatus}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding CoreHealthColor}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>





