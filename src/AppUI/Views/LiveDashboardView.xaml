<UserControl x:Class="AppUI.Views.LiveDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LiveDashboardViewModel}"
             d:DesignHeight="650" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">
            
            <!-- View Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Live Telemetry Dashboard" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Real-time frame pacing stability, cadence jitter, and FidelityFX ray reconstruction monitoring." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Active Game Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource CardContainer}" Padding="10,6" Margin="0" Background="#141822">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="Target: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ActiveGameTitle, FallbackValue='No Active Game'}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4 Metric Cards Row -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Current FPS Card -->
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Background="#251215" BorderBrush="{StaticResource Brush.Accent.Primary}">
                    <StackPanel>
                        <TextBlock Text="CURRENT FPS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Hover}" />
                        <TextBlock Text="{Binding FpsDisplayText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding AverageFps, StringFormat='Avg: {0:F1} FPS'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Frame Time Card -->
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="FRAME TIME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding FrameTimeDisplayText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MinFrameTime, StringFormat='Min: {0:F1}ms / '}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MaxFrameTime, StringFormat='Max: {0:F1}ms'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pacing Jitter Card -->
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="PACING JITTER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding JitterDisplayText}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Deviation from EMA Cadence" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Dropped Deadlines Card -->
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="MISSED DEADLINES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DroppedFrames}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,4" />
                        <TextBlock Text="Presentation delay &gt; 16ms" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live Frame-Time Graph Card -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Real-Time Frame-Time History (Last 120 Frames)" Style="{StaticResource TextCardTitle}" />
                            <Border Background="#2B1215" BorderBrush="#481B1E" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="60 Hz Polling" FontSize="10" FontWeight="SemiBold" Foreground="#FF7B85" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Width="12" Height="2" Background="#D29922" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="33.3ms (30fps)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <Border Width="12" Height="2" Background="#58A6FF" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="16.6ms (60fps)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <Border Width="12" Height="2" Background="#3FB950" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="8.3ms (120fps)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Graph Container Canvas -->
                    <Border Background="#0D0E12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="150">
                        <Grid ClipToBounds="True">
                            <!-- Horizontal reference grid lines -->
                            <!-- 16.67ms (60 FPS reference - mid-height) -->
                            <Line X1="0" Y1="75" X2="1000" Y2="75" Stroke="#58A6FF" Opacity="0.50" StrokeThickness="1" StrokeDashArray="4 4" />
                            <!-- 8.33ms (120 FPS reference - 75% down) -->
                            <Line X1="0" Y1="112" X2="1000" Y2="112" Stroke="#3FB950" Opacity="0.55" StrokeThickness="1" StrokeDashArray="4 4" />
                            <!-- 33.33ms (30 FPS reference - top) -->
                            <Line X1="0" Y1="10" X2="1000" Y2="10" Stroke="#D29922" Opacity="0.45" StrokeThickness="1" StrokeDashArray="4 4" />

                            <!-- Dynamic Graph Polyline -->
                            <Polyline Points="{Binding FrameTimeHistory, Converter={StaticResource FrameTimePointsConverter}}" 
                                      Stroke="#FF3B47" 
                                      StrokeThickness="2" 
                                      StrokeLineJoin="Round" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Active Pipeline Health & Interceptor Status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Frame Pacer Status Card -->
                <Border Grid.Column="0" Style="{StaticResource CardContainer}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsPacerActive, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="DXGI Frame Pacer Engine" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PacingStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="High-resolution waitable timers meter half-interval presentation cadence to eliminate micro-stuttering." 
                                   Style="{StaticResource TextSubheader}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Ray Reconstruction Status Card -->
                <Border Grid.Column="1" Style="{StaticResource CardContainer}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsRayRegenActive, Converter={StaticResource BoolToBrushConverter}}" />
                            <TextBlock Text="FidelityFX Ray Reconstruction" Style="{StaticResource TextCardTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DenoiserStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,4" />
                        <TextBlock Text="Streamline slSetTag interceptor routes radiance buffers through D3D12 compute wavelet filter pass." 
                                   Style="{StaticResource TextSubheader}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detected System Hardware Environment -->
            <Border Background="#12151B" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header Label -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Fill="#3FB950" Height="8" Margin="0,0,8,0" Width="8"/>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8B949E" Text="DETECTED HARDWARE" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hardware Metrics Grid -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GPU -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
                            <TextBlock FontSize="10" Foreground="#6E7681" Text="Primary GPU"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#E6EDF3" 
                                       Text="{Binding DetectedGpuName}" 
                                       ToolTip="{Binding DetectedGpuName}" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- VRAM -->
                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,16,0">
                            <TextBlock FontSize="10" Foreground="#6E7681" Text="Dedicated VRAM"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF4D58" 
                                       Text="{Binding DetectedVram}"
                                       ToolTip="{Binding DetectedVram}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Driver -->
                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,16,0">
                            <TextBlock FontSize="10" Foreground="#6E7681" Text="Driver Version"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" 
                                       Text="{Binding DetectedDriverVersion}"
                                       ToolTip="{Binding DetectedDriverVersion}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- CPU -->
                        <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,0,16,0">
                            <TextBlock FontSize="10" Foreground="#6E7681" Text="Host Processor"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" 
                                       Text="{Binding DetectedCpuName}" 
                                       ToolTip="{Binding DetectedCpuName}" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Display -->
                        <StackPanel Grid.Column="4" Orientation="Vertical">
                            <TextBlock FontSize="10" Foreground="#6E7681" Text="Active Display"/>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C9D1D9" 
                                       Text="{Binding DetectedDisplayMode}"
                                       ToolTip="{Binding DetectedDisplayMode}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
