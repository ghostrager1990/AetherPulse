<UserControl x:Class="AppUI.Views.CadenceTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             FontFamily="Bahnschrift"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CadenceTuningViewModel}"
             d:DesignHeight="950" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FpsSelectBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#162235"/>
                    <Setter Property="Foreground" Value="#58A6FF"/>
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <!-- Header Row -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Frame Pacing &amp; Smooth Delivery Tuning" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Configure microsecond swapchain frame timing, target frame caps, and sub-frame cadence synchronization." 
                               FontSize="13" Foreground="#8B949E" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="↺ Reset to Defaults" 
                            Command="{Binding ResetDefaultsCommand}"
                            Background="#161B22" Foreground="#FF6E6E" BorderBrush="#3D1418" BorderThickness="1"
                            Height="32" Padding="14,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0" />

                    <ComboBox ItemsSource="{Binding DataContext.AvailableTuningProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.ActiveTuningProfile, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValue="{Binding DataContext.ActiveTuningProfile.GameName, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValuePath="GameName"
                              DisplayMemberPath="GameName"
                              Style="{StaticResource DarkComboBox}"
                              Width="220" Height="32" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Card 1: Pacing & Motion Smoothness Switches -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Pacing &amp; Motion Smoothness" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <!-- Frame Delivery Pacing -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Frame Delivery Pacing" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#0D2818" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsExternalLimiterDetected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="[AUTO-PASSTHROUGH: RTSS DETECTED]" FontSize="9.5" FontWeight="Bold" Foreground="#3FB950" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Aligns rendered frames to exact millisecond intervals so motion feels silky-smooth and consistent." 
                                       FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.PacingEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Interpolation Frame Timing -->
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Interpolation Frame Timing (FSR 3 / AFMF / FSR-FG)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock FontSize="11.5" Foreground="#8B949E" Margin="0,2,0,0" Text="Dynamically synchronizes optical-flow interpolated frames to exact sub-intervals, eliminating presentation jitter and cadence judder." TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.HalfIntervalCadenceEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Frame Generation Multiplier & Cadence Dispatch -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Frame Generation Cadence &amp; Sub-Frame Multiplier" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <TextBlock Text="Optical-Flow Cadence Alignment Mode:" Foreground="#8B949E" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="1X (Native)" Style="{StaticResource FpsSelectBtn}" Tag="{Binding Is1xModeActive}" Command="{Binding SetFrameGenMultiplierCommand}" CommandParameter="1X" />
                        <Button Content="2X FG (50/50)" Style="{StaticResource FpsSelectBtn}" Tag="{Binding Is2xModeActive}" Command="{Binding SetFrameGenMultiplierCommand}" CommandParameter="2X" />
                        <Button Content="3X FG (33/66)" Style="{StaticResource FpsSelectBtn}" Tag="{Binding Is3xModeActive}" Command="{Binding SetFrameGenMultiplierCommand}" CommandParameter="3X" />
                        <Button Content="4X FG (Quad)" Style="{StaticResource FpsSelectBtn}" Tag="{Binding Is4xModeActive}" Command="{Binding SetFrameGenMultiplierCommand}" CommandParameter="4X" />
                    </StackPanel>

                    <!-- Cadence Handshake Reasoning & EMA Smoothing -->
                    <Border Background="#0D1117" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CadenceHandshakeReasoning}" FontSize="12" Foreground="#58A6FF" TextWrapping="Wrap" LineHeight="16" />
                    </Border>

                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Cadence EMA Smoothing Curve" VerticalAlignment="Center"/>
                                    <CheckBox Content="AUTO" IsChecked="{Binding IsAutoEmaEnabled, Mode=TwoWay}" Style="{StaticResource ModernToggle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="11.5" Foreground="#8B949E" Text="Controls exponential moving average response. Auto mode scales alpha (0.05 - 0.22) based on live frametime." Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Grid.Column="1" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#00FFCC" Text="{Binding EmaAlphaDisplay}"/>
                            </Border>
                        </Grid>
                        <Slider Minimum="0.01" Maximum="0.30" SmallChange="0.005" LargeChange="0.02" Value="{Binding ActiveProfile.EmaAlpha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManualEmaAllowed}" Opacity="{Binding EmaSliderOpacity}" Margin="0,4,0,6"/>
                        <TextBlock Text="{Binding SmoothingRecommendationText}" FontSize="11.5" Foreground="#58A6FF" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: System Latency & Queue Control -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="System Latency &amp; Queue Control" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <!-- Direct Hardware Presentation -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Direct Hardware Presentation (Bypass Windows DWM)" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Sends frames straight to your graphics card buffer for the lowest possible input delay." 
                                       FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.ForceFlipDiscard, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Queue Latency Depth Slider -->
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Queue Latency Depth" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="Controls how many frames the CPU can prepare ahead of GPU rendering." FontSize="11.5" Foreground="#8B949E" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveProfile.MaxFrameLatency, StringFormat='{}{0} Frame'}" FontWeight="Bold" FontSize="12.5" Foreground="#00FFCC" />
                            </Border>
                        </Grid>
                        <Slider Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ActiveProfile.MaxFrameLatency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding QueueDepthRecommendationText}" FontSize="11.5" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Microsecond Precision Timer Slider -->
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Microsecond Precision Timer" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="Fine-tunes the multimedia high-resolution timer sleep threshold before frame present." FontSize="11.5" Foreground="#8B949E" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveProfile.SpinYieldMicroseconds, StringFormat='{}{0} µs'}" FontWeight="Bold" FontSize="12.5" Foreground="#00FFCC" />
                            </Border>
                        </Grid>
                        <Slider Minimum="50" Maximum="1000" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding ActiveProfile.SpinYieldMicroseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding PrecisionTimerRecommendationText}" FontSize="11.5" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
