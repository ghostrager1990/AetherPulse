<UserControl x:Class="AppUI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:HelpViewModel}"
             d:DesignHeight="1300" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Optimization Manual &amp; Architecture Reference" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Detailed tuning explanations for frame pacing cadence, FSR 4 upscaling clarity, and FidelityFX ray reconstruction." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Quick Start Guide Callout Banner -->
            <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Looking for quick setup steps?" FontWeight="Bold" Foreground="#FF424D" FontSize="13" />
                        <TextBlock Text="Get your first game configured with optimal presets in 3 simple steps." Foreground="#C9D1D9" FontSize="11.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="View the Quick Start Guide →" Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" FontSize="11.5"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static vm:NavigationPage.QuickStart}" />
                </Grid>
            </Border>

            <!-- Card 1: Frame Pacing (AFMF / FSR-FG) Cadence Alignment -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="⏱ " FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AmdRedBrush}" />
                        <TextBlock Text="AMD Frame Gen (AFMF / FSR-FG) Cadence Alignment" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Section 1: Strict Frame Cadence -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Strict Half-Interval Frame Cadence" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="AMD Frame Generation creates an interpolated frame between each traditionally rendered frame. If presentation timings fluctuate (e.g., an 8ms frame followed by a 24ms frame), micro-stutter occurs even at high reported FPS. AetherPulse aligns real and generated frames into uniform, evenly spaced delivery intervals for seamless motion smoothness." />
                        </StackPanel>
                    </Border>

                    <!-- Section 2: High-Precision Spin-Wait Limiter -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="High-Resolution Waitable Timers &amp; Spin-Yield Threshold" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Standard Windows Sleep(1) timers suffer from 1-15ms OS thread scheduler quantization error. AetherPulse utilizes CREATE_WAITABLE_TIMER_HIGH_RESOLUTION with sub-millisecond precision. For the final 500 µs before presentation deadline, the engine transitions into a fine-grained CPU spin loop to hit exact presentation VSync targets with zero queue jitter." />
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Anti-Lag 2 Alignment -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="AMD Radeon Anti-Lag 2 Driver-Level Alignment" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Anti-Lag 2 operates at the driver layer to pace CPU frame submission directly against GPU render progress. By preventing the CPU from building excessive queue buffer latency during frame generation, click-to-photon input latency is reduced by up to 35% without requiring proprietary SDK game integrations." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: Display Sync & Refresh Rate Best Practices -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🖥️ " FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AmdRedBrush}" />
                        <TextBlock Text="Display Sync &amp; Refresh Rate Best Practices" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Section 1: VRR / FreeSync / G-Sync -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VRR / FreeSync / G-Sync Displays" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Keep In-Game VSync OFF, VRR ON, and cap FPS 3–4 frames below your monitor's maximum refresh rate to stay within the variable sync range." />
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Fixed Refresh Displays -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Fixed Refresh Displays (60Hz / 120Hz)" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Enable AetherPulse DXGI Frame Pacing or standard VSync to eliminate tearing during frame generation playback." />
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Frame Generation Notice -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Frame Generation VSync Notice" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Disable in-game VSync whenever Frame Generation is enabled to prevent presentation queue latency and judder." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: FSR 4 Upscaling & Clarity Guide -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🔍 " FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AmdRedBrush}" />
                        <TextBlock Text="FSR 4 Upscaling, Sharpening &amp; LOD Clarity" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- In-Game Setup Note Callout -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <StackPanel Width="720">
                                <TextBlock Text="In-Game Setup Note:" FontWeight="Bold" Foreground="#58A6FF" FontSize="12.5" Margin="0,0,0,2" />
                                <TextBlock Text="For games where Ray Reconstruction requires DLSS to be selected in the settings menu, select 'DLSS' in-game. AetherPulse automatically intercepts DLSS calls and executes the FSR 4 upscaling engine and FidelityFX Ray Regeneration under the hood." 
                                           Foreground="#C9D1D9" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section 1: FidelityFX RCAS -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Robust Contrast-Adaptive Sharpening (FidelityFX RCAS)" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Unlike standard unsharp masking which amplifies noise and causes high-contrast halo ringing, FidelityFX RCAS analyzes local contrast variations. It sharpens subtle textures while dynamically attenuating edge contrast. A setting of 0.35 provides pristine crispness without artifacting." />
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Negative Mipmap LOD Bias -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Negative Mipmap LOD Bias Calculation" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="When rendering at lower internal resolutions (e.g. 1440p upscaled to 4K), game engines sample blurrier mipmap levels. AetherPulse offsets Direct3D 12 texture samplers with a negative LOD bias calculated as -0.5 * log2(UpscaleRatio): -0.58 for Quality Mode, -1.00 for Balanced Mode, restoring native texture micro-details." />
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Reactive Mask Threshold -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Reactive Mask &amp; Alpha Transparency Protection" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Alpha-tested particle effects (smoke, fire, magic spell trails) lack motion vectors and frequently ghost when upscaled temporally. Setting a reactive mask sensitivity of 0.10 automatically rejects historical samples for transparent layers to guarantee ghost-free particle effects." />
                        </StackPanel>
                    </Border>

                    <!-- Section 4: DRS Floor -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Dynamic Resolution Scaling (DRS) Floor Clamping (67% - 75%)" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Dynamic resolution scaling engines frequently drop internal resolutions down to 50% during heavy combat. Clamping the DRS floor to 67-75% prevents aggressive resolution drops, maintaining stable reconstruction clarity." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Ray Regeneration & Wavelet Denoising Guide -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="✨ " FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AmdRedBrush}" />
                        <TextBlock Text="Ray Regeneration &amp; Wavelet Denoising Architecture" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Plain-English Overview Callout -->
                    <Border Background="{StaticResource Brush.Callout.Background}" BorderBrush="{StaticResource Brush.Callout.Border}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="How Ray Regeneration Works (In Plain English)" FontWeight="Bold" Foreground="{StaticResource Brush.Callout.Icon}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Callout.Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Real-time ray tracing generates speckled, noisy lighting because the GPU can only cast a few rays per pixel. Ray Regeneration acts as an intelligent filter that cleans up this grain across consecutive frames while keeping object edges razor sharp, delivering clean and flicker-free reflections." />
                        </StackPanel>
                    </Border>

                    <!-- Wavelet Passes -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Multi-Pass à-trous Spatial Wavelet Iterations" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Wavelet filters denoise Monte Carlo ray tracing by expanding 5x5 filter kernels across exponentially increasing step sizes (1, 2, 4, 8 pixels). 1-pass offers ultra-fast response for mobile/APU hardware; 2-pass balances noise and compute efficiency; 3-pass delivers path-traced mirror smoothness." />
                        </StackPanel>
                    </Border>

                    <!-- Temporal Accumulation -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Temporal Sample Accumulation (0.75 - 0.92)" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Higher temporal accumulation weights blend more historical ray samples to produce noise-free lighting. AetherPulse pairs this with disocclusion rejection, automatically flushing temporal history when geometry or camera movement reveals previously occluded pixels." />
                        </StackPanel>
                    </Border>

                    <!-- Bilateral Weights -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Bilateral Depth &amp; Normal Edge-Stopping Gating &amp; Auto-Exposure" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Bilateral filters use surface normal exponents (Normal Sigma: 32-96) and depth sensitivity (Depth Sigma: 0.8-1.5) to halt spatial filtering across geometry boundaries. Auto-exposure clamping prevents high-intensity specular spike flickers." />
                        </StackPanel>
                    </Border>

                    <!-- NRC Acceleration -->
                    <Border Background="#1C2027" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Neural Radiance Caching (NRC) Acceleration" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                       Text="Powers amd_fidelityfx_radiancecache_dx12.dll to cache and interpolate multi-bounce global illumination across world-space probes, drastically cutting ray dispatch overhead in heavy path-traced scenes." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 4: Preset Hardware Matrix Reference -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🎮 " FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AmdRedBrush}" />
                        <TextBlock Text="Hardware Preset Recommendations Matrix" Style="{StaticResource TextCardTitle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- High Performance -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚀" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="High Performance Preset" FontWeight="Bold" Foreground="#FF424D" FontSize="14" />
                                <TextBlock Text="1 Pass Wavelet | 0.75 History | 0.65 Roughness | 0.80 Depth | 32.0 Normal" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,4" />
                                <TextBlock Text="Recommended for: Radeon RX 6600, RX 6700, Radeon 780M / 890M APUs • Minimum VRAM: 8 GB" FontWeight="SemiBold" FontSize="11.5" Foreground="#FF9AA2" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Balanced -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚡" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Balanced Preset" FontWeight="Bold" Foreground="#FF424D" FontSize="14" />
                                <TextBlock Text="2 Pass Wavelet | 0.85 History | 0.50 Roughness | 1.00 Depth | 64.0 Normal" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,4" />
                                <TextBlock Text="Recommended for: Radeon RX 7000 Series / RX 6700 XT+ • Minimum VRAM: 12 GB" FontWeight="SemiBold" FontSize="11.5" Foreground="#FF9AA2" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ultra -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔥" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ultra Ray Tracing Preset" FontWeight="Bold" Foreground="#FF424D" FontSize="14" />
                                <TextBlock Text="3 Pass Wavelet | 0.90 History | 0.30 Roughness | 1.50 Depth | 96.0 Normal" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,4" />
                                <TextBlock Text="Recommended for: Radeon RX 9000 Series (RDNA 4), RX 7900 XT / XTX • Minimum VRAM: 16 GB" FontWeight="SemiBold" FontSize="11.5" Foreground="#FF9AA2" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
