<UserControl x:Class="AppUI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="1400" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <!-- Header Row -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Optimization Manual &amp; Pacing Reference" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Comprehensive technical breakdown and configuration guide for all frame pacing and cadence synchronization controls."
                           FontSize="13" Foreground="#8B949E" Margin="0,4,0,0" LineHeight="18" />
            </StackPanel>

            <!-- Quick Action Banner -->
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Need automated configuration?" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Switch cadence curve to AUTO and enable RTSS Passthrough for instant hands-off pacing." FontSize="11.5" Foreground="#8B949E" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#0D2818" BorderBrush="#2EA043" BorderThickness="1" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="Recommended Baseline" FontSize="11" FontWeight="Bold" Foreground="#3FB950" />
                    </Border>
                </Grid>
            </Border>

            <!-- Section 1: Pacing & Motion Smoothness -->
            <TextBlock Text="⚡ Section 1: Pacing &amp; Motion Smoothness" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,12" />

            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Setting 1 -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Frame Delivery Pacing" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Intercepts DXGI swapchain Present calls and aligns frame intervals to microsecond precision using hardware waitable objects instead of standard OS sleep timers." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Keep ENABLED for all games. Eliminates presentation jitter, cluster-frametime spikes, and uneven motion delivery." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Setting 2 -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RTSS Auto-Passthrough Integration" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Detects active frame limits set in RivaTuner Statistics Server via shared memory IPC. Yields internal timer caps to RTSS to prevent dual-limiter competition while enforcing sub-frame cadence ratios." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Set your target FPS limit in RTSS (e.g., 3-4 FPS below monitor refresh). AetherPulse displays [AUTO-PASSTHROUGH: RTSS DETECTED] and aligns frame intervals accordingly." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Setting 3 -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Interpolation Frame Timing (FSR 3 / AFMF / FSR-FG)" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Dynamically paces optical-flow generated frames to exact fractional sub-intervals (50/50 for 2X, 33/66 for 3X), preventing the real-and-generated frame bunching that causes judder." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Enable whenever in-game Frame Generation or driver AFMF 2 is active. Disable for pure native rendering." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 2: Cadence Alignment & Smoothing -->
            <TextBlock Text="🎯 Section 2: Cadence Alignment &amp; Smoothing Controls" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,12" />

            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Mode Multipliers -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Optical-Flow Cadence Alignment Modes (1X / 2X / 3X / 4X)" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What each mode does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="• 1X (Native): 100% pacing to exact render intervals with no interpolation offset." FontSize="11.5" Foreground="#8B949E" Margin="0,1,0,1" />
                            <TextBlock Text="• 2X FG (50/50): Divides frame delivery into uniform 50% intervals between rendered and generated frames." FontSize="11.5" Foreground="#8B949E" Margin="0,1,0,1" />
                            <TextBlock Text="• 3X FG (33/66): Trisection dispatch for 3X generation pipelines (1 rendered + 2 generated)." FontSize="11.5" Foreground="#8B949E" Margin="0,1,0,1" />
                            <TextBlock Text="• 4X FG (Quad): Quarter-step distribution for quad-rate generation frameworks." FontSize="11.5" Foreground="#8B949E" Margin="0,1,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Use 2X FG (50/50) for FSR 3 Frame Generation and AFMF 2. Match the mode directly to the active generation multiplier." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Cadence EMA Curve -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Cadence EMA Smoothing Curve &amp; Alpha Weight" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Uses an Exponential Moving Average (EMA) to filter out transient frametime spikes. A lower alpha produces heavy filtering (smooth delivery, slower adaptation during rapid camera turns); a higher alpha provides immediate reactivity." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Keep AUTO checked. Auto mode continuously scales alpha between 0.05 (stable 40 FPS scenarios) and 0.22 (high-velocity 144Hz+ scenarios) based on live frametimes." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 3: Latency & Queue Control -->
            <TextBlock Text="⏱️ Section 3: Latency &amp; Presentation Queue Control" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,12" />

            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Direct Hardware Presentation -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Direct Hardware Presentation (Bypass Windows DWM)" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Forces DXGI Flip Discard presentation model directly to the scanout surface, completely bypassing Desktop Window Manager compositing buffers." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="ENABLE this setting. Delivers true fullscreen latency characteristics in borderless windowed modes with zero input lag penalty." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Queue Latency Depth -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Queue Latency Depth (Max Pre-Rendered Frames)" FontWeight="Bold" Foreground="#58A6FF" FontSize="13.5" Margin="0,0,0,4" />
                            <TextBlock Text="What it does:" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Controls how many frames the CPU can submit ahead of GPU render completion (1 Frame = zero buffer delay; 2-3 Frames = smoother throughput on CPU-bound configurations)." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Recommendation:" FontWeight="SemiBold" Foreground="#3FB950" FontSize="12" Margin="0,2,0,2" />
                            <TextBlock Text="Set to 1 Frame for lowest click-to-photon latency when using VRR/FreeSync. If experiencing CPU micro-stutter in heavy open-world games, set to 2 Frames." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 4: Display Best Practices -->
            <TextBlock Text="🖥️ Section 4: Synchronization Best Practices" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,12" />

            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <Border Background="#0D1117" BorderBrush="#238636" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Variable Refresh Rate (FreeSync / G-Sync)" FontWeight="Bold" Foreground="#3FB950" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="Keep in-game V-Sync OFF. Enable VRR in your driver, and cap FPS 3-4 frames below max refresh (e.g., 140 FPS on 144Hz) to remain strictly inside the active VRR window." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="In-Game V-Sync &amp; Frame Generation Rule" FontWeight="Bold" Foreground="#58A6FF" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="Always DISABLE standard in-game V-Sync when Frame Generation (FSR-FG or AFMF) is turned on. In-game V-Sync forces pipeline serialization that creates severe cadence judder and latency queues." FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>