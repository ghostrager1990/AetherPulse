<Window x:Class="AppUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppUI.ViewModels"
        xmlns:views="clr-namespace:AppUI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AetherPulse" 
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="800" Width="1280"
        MinHeight="800" MinWidth="1280"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        Opacity="{Binding OverlayOpacity}"
        SourceInitialized="OnSourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:LiveDashboardViewModel}">
            <views:LiveDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickStartViewModel}">
            <views:QuickStartView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}">
            <views:GameLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PacingTuningViewModel}">
            <views:PacingTuningView />
        </DataTemplate>
        
        
        <DataTemplate DataType="{x:Type vm:ArchitectureInfoViewModel}">
            <views:ArchitectureInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
    </Window.Resources>

    <!-- Main Window Outer Shell -->
    <Border x:Name="RootWindowBorder"
            Background="{StaticResource BgDarkBrush}" 
            BorderBrush="{StaticResource BorderDarkBrush}" 
            BorderThickness="1" 
            CornerRadius="10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Ambient FidelityFX Redstone Ambient Canvas -->
            <Grid Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
                <Ellipse Height="900" HorizontalAlignment="Right" Margin="0,-350,-200,0" Opacity="0.12" VerticalAlignment="Top" Width="900">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#E01E26" Offset="0.0"/>
                            <GradientStop Color="#5A0D11" Offset="0.5"/>
                            <GradientStop Color="#000D0E12" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Height="700" HorizontalAlignment="Left" Margin="-250,0,0,-300" Opacity="0.08" VerticalAlignment="Bottom" Width="700">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#E01E26" Offset="0.0"/>
                            <GradientStop Color="#000D0E12" Offset="0.9"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path Data="M100,0 L200,50 L200,150 L100,200 L0,150 L0,50 Z" Height="400" HorizontalAlignment="Right" Margin="0,-50,-50,0" Opacity="0.04" Stretch="Uniform" Stroke="#E01E26" StrokeThickness="1" VerticalAlignment="Top" Width="400"/>
                <Path Data="M150,0 L300,75 L300,225 L150,300 L0,225 L0,75 Z" Height="550" HorizontalAlignment="Right" Margin="0,0,-100,-150" Opacity="0.03" Stretch="Uniform" Stroke="#FF424D" StrokeThickness="0.8" VerticalAlignment="Bottom" Width="550"/>
            </Grid>

            <!-- Custom Draggable TitleBar -->
            <Grid Grid.Row="0" Background="#0A0C11" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Assets/app_icon.png" Width="24"/>
                    <TextBlock Text="AETHER" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="PULSE" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="2,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.2.0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Active Game Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeRunning}" Visibility="{Binding IsAnyGameRunning, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#00FF66" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="ACTIVE (Hook Injected &amp; Telemetry Live) - " FontWeight="Bold" FontSize="10" Foreground="#00FF66" />
                            <TextBlock Text="{Binding ActiveRunningGameName}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardContainer}" Padding="8,2" Margin="0" Background="#161A22" Visibility="{Binding IsAnyGameRunning, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="#8B949E" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="STANDBY (Waiting for Game Injection)" FontWeight="SemiBold" FontSize="10" Foreground="#8B949E" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Overlay Controls & Window Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- HUD Opacity Slider -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="HUD Opacity" Foreground="#7D8590" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Minimum="0.30" Maximum="1.00" Value="{Binding OverlayOpacity}" Width="65" VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1" />
                    </StackPanel>

                    <!-- Always-on-Top Pin Button -->
                    <ToggleButton Background="Transparent" BorderThickness="0" Cursor="Hand" Height="28" IsChecked="{Binding IsAlwaysOnTop}" Margin="0,0,8,0" ToolTip="Pin Window (Always on Top)" Width="28" VerticalAlignment="Center">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" Fill="#7D8590" Height="12" Stretch="Uniform" Width="12" x:Name="PinIcon"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Fill" TargetName="PinIcon" Value="#00F0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Standard Window Buttons -->
                    <Button Style="{StaticResource WindowControlButton}" Height="38" Width="46" Content="―" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource WindowControlButton}" Height="38" Width="46" Content="⬜" Click="OnMaximizeClick" Visibility="Collapsed" />
                    <Button Style="{StaticResource WindowCloseButton}" Height="38" Width="48" Content="✕" Click="OnCloseClick" Margin="0" />
                </StackPanel>
            </Grid>

            <!-- Main Layout Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation Rail -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nav Buttons List -->
                        <StackPanel Grid.Row="0" Margin="0,12,0,0">
                            <!-- Live Telemetry -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.Dashboard}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M11.5,1 L2,13 L10,13 L8.5,23 L18,11 L10,11 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Live Telemetry" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Quick Start -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.QuickStart}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="14" Foreground="{StaticResource AmdRedBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Start" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Game Library -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.Library}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M4,6 C2.9,6 2,6.9 2,8 L2,14 C2,16.2 3.8,18 6,18 L7.5,18 L9,15 L15,15 L16.5,18 L18,18 C20.2,18 22,16.2 22,14 L22,8 C22,6.9 21.1,6 20,6 L4,6 Z M7,9 L9,9 L9,11 L7,11 L7,13 L5,13 L5,11 L3,11 L3,9 L5,9 L5,7 L7,7 L7,9 Z M17,13 C16.4,13 16,12.6 16,12 C16,11.4 16.4,11 17,11 C17.6,11 18,11.4 18,12 C18,12.6 17.6,13 17,13 Z M19,10 C18.4,10 18,9.6 18,9 C18,8.4 18.4,8 19,8 C19.6,8 20,8.4 20,9 C20,9.6 19.6,10 19,10 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Game Library" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Frame Pacing (FSR-FG) -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.PacingTuning}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M12,2 C6.5,2 2,6.5 2,12 C2,17.5 6.5,22 12,22 C17.5,22 22,17.5 22,12 C22,6.5 17.5,22 12,2 Z M12,4 C16.4,4 20,7.6 20,12 C20,16.4 16.4,20 12,20 C7.6,20 4,16.4 4,12 C4,7.6 7.6,4 12,4 Z M11,7 L11,13 L16.2,16.2 L17,14.8 L12.5,12.2 L12.5,7 L11,7 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Frame Pacing Engine" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Margin="14,10,14,6" Padding="0,0,0,4" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                
                            </Border>

                            <!-- Files & Architecture -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.ArchitectureInfo}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M4,4 L20,4 L20,7 L4,7 Z M4,9 L20,9 L20,12 L4,12 Z M4,14 L20,14 L20,17 L4,17 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Files &amp; Architecture" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.Settings}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M19.4,13 C19.5,12.7 19.5,12.3 19.5,12 C19.5,11.7 19.5,11.3 19.4,11 L21.5,9.4 C21.7,9.2 21.8,8.9 21.6,8.7 L19.6,5.2 C19.5,5 19.2,4.9 19,5 L16.5,6 C16,5.6 15.4,5.3 14.8,5.1 L14.4,2.4 C14.4,2.2 14.2,2 13.9,2 L10,2 C9.8,2 9.6,2.2 9.5,2.4 L9.2,5.1 C8.6,5.3 8,5.6 7.5,6 L5,5 C4.8,4.9 4.5,5 4.4,5.2 L2.4,8.7 C2.2,8.9 2.3,9.2 2.5,9.4 L4.6,11 C4.5,11.3 4.5,11.7 4.5,12 C4.5,12.3 4.5,12.7 4.6,13 L2.5,14.6 C2.3,14.8 2.2,15.1 2.4,15.3 L4.4,18.8 C4.5,19 4.8,19.1 5,19 L7.5,18 C8,18.4 8.6,18.7 9.2,18.9 L9.5,21.6 C9.6,21.8 9.8,22 10,22 L13.9,22 C14.2,22 14.4,21.8 14.4,21.6 L14.8,18.9 C15.4,18.7 16,18.4 16.5,18 L19,19 C19.2,19.1 19.5,19 19.6,18.8 L21.6,15.3 C21.8,15.1 21.7,14.8 21.5,14.6 L19.4,13 Z M12,15.5 C10.1,15.5 8.5,13.9 8.5,12 C8.5,10.1 10.1,8.5 12,8.5 C13.9,8.5 15.5,10.1 15.5,12 C15.5,13.9 13.9,15.5 12,15.5 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Help & Guide -->
                            <Button Style="{StaticResource NavButton}" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="{x:Static vm:NavigationPage.Help}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                          Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M11,16 L13,16 L13,18 L11,18 Z M12,6 C9.79,6 8,7.79 8,10 L10,10 C10,8.9 10.9,8 12,8 C13.1,8 14,8.9 14,10 C14,12 11,11.75 11,15 L13,15 C13,12.75 16,12.5 16,10 C16,7.79 14.21,6 12,6 Z" Margin="0,0,12,0" />
                                    <TextBlock Text="Optimization Manual" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Bottom Version Info -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="14,12">
                            <StackPanel Margin="16,0,16,16" VerticalAlignment="Bottom">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Text="AetherPulse v1.2.0"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,1,0,0" Text="AMD FidelityFX &amp; FSR 4 Bridge"/>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,3,0,0" Opacity="0.75" Text="by Stanorius Software ©"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active Page Content Area -->
                <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
            </Grid>

        </Grid>
    </Border>
</Window>

