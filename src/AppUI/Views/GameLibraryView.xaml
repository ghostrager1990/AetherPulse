<UserControl x:Class="AppUI.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             xmlns:models="clr-namespace:AppUI.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GameLibraryViewModel}"
             d:DesignHeight="750" d:DesignWidth="850">
    
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1A1C23"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#405070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Library View -->
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- View Header & Action Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Game Library" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Manage game profiles, proxy hook deployment, and launch settings." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="+ Add Game" Style="{StaticResource BtnPrimary}" Click="OnAddGameClick" Margin="0,0,8,0" />
                    <Button Content="Auto-Scan Installed" Style="{StaticResource BtnSecondary}" Command="{Binding AutoScanGamesCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource BoolToBrushConverter}}" />
                </StackPanel>
            </Grid>

            <!-- Status & Filter Bar -->
            <Border Grid.Row="1" Background="#141720" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Total Games: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding GameProfiles.Count}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Games Grid / List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GameProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GameProfile}">
                            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Icon / Avatar -->
                                    <Border Grid.Column="0" Width="44" Height="44" Background="#1E2433" CornerRadius="6" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Game Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding GameName}" Style="{StaticResource TextCardTitle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            
                                            <!-- Mode Badge with explicit ToolTip & Background hit-testing -->
                                            <Border Background="#1A1C24" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Universal proxy chainloader (version.dll) provides conflict-free Direct3D 12 SwapChain presentation cadence alignment, half-interval pacing, and latency metering.">
                                                <TextBlock Text="{Binding ProxyTypeBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            </Border>

                                            <!-- Hook Status Badge -->
                                            <Border Background="{Binding IsHookDeployed, Converter={StaticResource BoolToBrushConverter}}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    ToolTip="Indicates whether the runtime proxy DLL is currently deployed in the game's executable directory.">
                                                <TextBlock Text="{Binding IsHookDeployed, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Deployed:Clean'}" 
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            </Border>

                                            <!-- Anti-Cheat Warning Badge -->
                                            <Border Background="#3D1418" BorderBrush="#E01E26" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAntiCheatWarning, Converter={StaticResource BoolToVisConverter}}"
                                                    ToolTip="Warning: Multiplayer anti-cheat detected. Using proxy DLLs online may risk account suspension.">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚠️ " FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock Text="Anti-Cheat Protected" FontSize="10.5" FontWeight="Bold" Foreground="#FF7B85" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Running Status Badge -->
                                            <Border Style="{StaticResource BadgeRunning}" VerticalAlignment="Center" Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisConverter}}"
                                                    ToolTip="Game process is actively running and receiving presentation hooks.">
                                                <TextBlock Text="IN-GAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenGlowBrush}" />
                                            </Border>
                                        </WrapPanel>

                                        <!-- Executable Path -->
                                        <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource TextSubheader}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

                                        <!-- Recommended Game Capability Alert Badge -->
                                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,2,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasCapabilityBadge, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="This title supports native D3D12 Ray Tracing. AetherPulse provides high-precision DXGI present pacing, half-interval cadence alignment, and experimental Ray Reconstruction hooks.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🧩 " FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Capability.BadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            </StackPanel>
                                        </Border>

                                        <!-- OptiScaler Conflict Warning Banner -->
                                        <Border Background="#261A08" BorderBrush="#FF9900" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                                HorizontalAlignment="Stretch"
                                                Visibility="{Binding HasOptiScalerConflict, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OptiScalerWarningMessage}" 
                                                               Foreground="#FFCC66" FontSize="11" TextWrapping="Wrap" LineHeight="15" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Clean Conflicting Mods" Style="{StaticResource BtnWarning}" Height="26" Padding="10,2" FontSize="11" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.CleanConflictsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Safely removes OptiScaler artifacts while strictly keeping ReShade intact." />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Core Engine Chip -->
                                        <Border Background="#161B26" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,6,0" VerticalAlignment="Center"
                                                ToolTip="Active injection DLL filename used by the chainloader.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ " Foreground="#58A6FF" FontSize="11" />
                                                <TextBlock Text="{Binding ProxyDisplayLabel, FallbackValue='version.dll'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>

                                        <Button Content="⚙ Tune" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2" Margin="0,0,5,0"
                                                Command="{Binding DataContext.TuneGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open Frame Pacing &amp; Upscaling configuration for this title." />

                                        <Button Content="Deploy" Style="{StaticResource BtnPrimary}" Height="28" Padding="10,2" Margin="0,0,5,0"
                                                Command="{Binding DataContext.DeployCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copies version.dll and configuration into the game folder." />

                                        <Button Content="Uninstall Hook" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2" Margin="0,0,5,0"
                                                Command="{Binding DataContext.RemoveHookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Removes deployed AetherPulse proxy DLLs from the game directory." />

                                        <Button Content="▶ Launch" Style="{StaticResource BtnSecondary}" Height="28" Padding="10,2" Margin="0,0,5,0"
                                                Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Executes the target game executable directly." />

                                        <Button Content="✕" Style="{StaticResource BtnDanger}" Height="28" Padding="8,2" Margin="0,0,0,0"
                                                Command="{Binding DataContext.DeleteGameFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Removes this game profile from your library." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Library Footer Hazard Warning Beacon Note -->
            <Border Grid.Row="3" Background="#1A0A0A" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,20,0,10" HorizontalAlignment="Stretch">
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="HazardBorderBrush" Color="#FFFF3333" />
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect x:Name="HazardGlow" Color="#FF3333" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <ColorAnimation Storyboard.TargetName="HazardBorderBrush"
                                                Storyboard.TargetProperty="Color"
                                                From="#44FF3333" To="#FFFF3333"
                                                Duration="0:0:1.2" />
                                <DoubleAnimation Storyboard.TargetName="HazardGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.2" To="0.9"
                                                 Duration="0:0:1.2" />
                            </Storyboard>
                        </BeginStoryboard>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <ColorAnimationUsingKeyFrames Duration="0:0:0.8" Storyboard.TargetName="SirenIcon" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                    <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="#FF2222"/>
                                    <DiscreteColorKeyFrame KeyTime="0:0:0.2" Value="#FF4444"/>
                                    <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="#0088FF"/>
                                    <DiscreteColorKeyFrame KeyTime="0:0:0.6" Value="#33AAFF"/>
                                    <DiscreteColorKeyFrame KeyTime="0:0:0.8" Value="#FF2222"/>
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SirenIcon" Grid.Column="0" Text="🚨" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FF2222" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="HAZARD WARNING: ONLINE &amp; ANTI-CHEAT PROTECTED GAMES" 
                                   Foreground="#FF4D4D" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,2" />
                        <TextBlock Text="D3D12/Streamline proxy injection (version.dll, dxgi.dll) is strictly intended for offline &amp; single-player titles. Online games with anti-cheat software (EAC, BattlEye, Vanguard, Ricochet) may flag custom proxy DLLs. Always verify game compatibility before deploying." 
                                   Foreground="#FFAA88" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Compatibility Verification Warning Modal Dialog -->
        <Grid Background="#B0000000" 
              Visibility="{Binding ValidationFailureModalVisible, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="100">
            <Border Background="#15181E" 
                    BorderBrush="#E01E26" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    MaxWidth="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="⚠️ Compatibility Verification Failed" FontSize="15" FontWeight="Bold" Foreground="#FF424D" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ValidationTargetName, StringFormat='Target: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,10" />
                    <TextBlock Text="The selected game does not meet all required injection criteria:" Foreground="#C9D1D9" FontSize="12.5" Margin="0,0,0,12" />

                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Direct3D 12 (D3D12) API" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F3F6" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓ Passed (D3D12 Detected)" Foreground="#3FB950" FontWeight="Bold" FontSize="12" Visibility="{Binding IsDx12Passed, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="✗ Failed (Requires DirectX 12)" Foreground="#FF424D" FontWeight="Bold" FontSize="12" Visibility="{Binding IsDx12Passed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Separator Background="#4D1C21" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DLSS / Streamline Hook" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F3F6" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓ Passed (DLSS/Streamline Found)" Foreground="#3FB950" FontWeight="Bold" FontSize="12" Visibility="{Binding IsDlssPassed, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="✗ Failed (Missing nvngx_dlss.dll / Streamline)" Foreground="#FF424D" FontWeight="Bold" FontSize="12" Visibility="{Binding IsDlssPassed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AetherPulse frame pacing and Ray Regeneration intercept Direct3D 12 swapchains and Streamline buffer tags. Without these, runtime injection may not take effect." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel Import" Style="{StaticResource BtnSecondary}" Height="34" Command="{Binding CancelValidationModalCommand}" />
                        <Button Grid.Column="2" Content="Force Add Anyway" Background="#3D1418" Foreground="#FF7B85" BorderBrush="#E01E26" BorderThickness="1" Height="34" Cursor="Hand" FontWeight="SemiBold" Command="{Binding ConfirmForceAddGameCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glaring Anti-Cheat Hazard Warning & Liability Waiver Modal -->
        <Grid Background="#B0000000" Visibility="{Binding AntiCheatModalVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="110">
            <Border Background="#15181E" BorderBrush="#FF3838" BorderThickness="1.5" CornerRadius="8" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel>
                    <TextBlock Text="🚨 HIGH RISK: ONLINE / ANTI-CHEAT PROTECTED GAME" FontSize="14.5" FontWeight="Bold" Foreground="#FF3838" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding AntiCheatTargetGameName, StringFormat='Target: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0F3F6" Margin="0,0,12,0" />
                        <Border Background="#3D1418" BorderBrush="#E01E26" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding AntiCheatDetectedSystem, StringFormat='System: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#FF7B85" />
                        </Border>
                    </StackPanel>

                    <Border Background="#250D11" BorderBrush="#5C1820" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Explicit Ban Warning:" FontWeight="Bold" Foreground="#FF5E68" FontSize="12" Margin="0,0,0,4" />
                            <TextBlock Text="Injecting runtime proxy DLLs (version.dll, dxgi.dll) into games with active anti-cheat systems can be flagged as unauthorized third-party software and may result in an immediate, permanent ACCOUNT BAN." Foreground="#E6EDF3" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <Border Background="#121620" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Developer Liability Waiver:" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,4" />
                            <TextBlock Text="AetherPulse and Stanorius Software are strictly built for single-player and offline rendering enhancements. The software and developer assume ZERO responsibility or liability for account suspensions, penalties, or bans incurred on multiplayer servers." Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="15" />
                        </StackPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding AntiCheatLiabilityAcknowledged, Mode=TwoWay}" Margin="0,0,0,18" Cursor="Hand">
                        <TextBlock Text="I understand the severe risk of account bans and assume full personal responsibility." Foreground="#F0F3F6" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </CheckBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel (Recommended / Safe)" Style="{StaticResource BtnSecondary}" Height="36" Command="{Binding CancelAntiCheatModalCommand}" />
                        <Button Grid.Column="2" Content="Proceed at Own Risk" Style="{StaticResource BtnDanger}" Height="36" IsEnabled="{Binding AntiCheatLiabilityAcknowledged}" Command="{Binding ConfirmAntiCheatDeployCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>