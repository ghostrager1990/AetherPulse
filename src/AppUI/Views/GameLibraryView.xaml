<UserControl x:Class="AppUI.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             xmlns:models="clr-namespace:AppUI.Models"
             FontFamily="Bahnschrift"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GameLibraryViewModel}"
             d:DesignHeight="750" d:DesignWidth="850">
    
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#161A22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="LineHeight" Value="16"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Library View -->
        <Grid Margin="28,20,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- View Header & Action Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Game Library" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Manage game profiles, runtime proxy hooks, and launch configurations." 
                               FontSize="13.5" Foreground="#8B949E" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="+ Add Game" Style="{StaticResource BtnPrimary}" Click="OnAddGameClick" Height="36" Padding="18,0" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                </StackPanel>
            </Grid>

            <!-- Status & Summary Bar -->
            <Border Grid.Row="1" Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" Foreground="#8B949E" VerticalAlignment="Center" FontSize="13.5" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Total Configured Games: " Foreground="#8B949E" FontSize="13.5" />
                        <TextBlock Text="{Binding GameProfiles.Count}" Foreground="#00FFCC" FontWeight="Bold" FontSize="14" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Games List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GameProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GameProfile}">
                            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16" Padding="18">
                                <StackPanel>
                                    <!-- Top Main Row: Icon, Titles/Badges, and Action Button Group -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Dynamic Exe Game Icon -->
                                        <Border Grid.Column="0" Width="52" Height="52" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Image Source="{Binding GameIcon}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisConverter}}" />
                                                <TextBlock Text="🎮" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasGameIcon, Converter={StaticResource InverseBoolToVisConverter}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Title & Status Header -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding GameName}" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                
                                                <!-- Proxy Type Badge -->
                                                <Border Background="#161B26" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        ToolTip="Universal proxy bridge that intercepts Direct3D 12 SwapChain presentation to align frame delivery intervals and hardware sync.">
                                                    <TextBlock Text="{Binding ProxyTypeBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#58A6FF" />
                                                </Border>

                                                <!-- Hook Deployed Status Pill -->
                                                <Border Background="{Binding IsHookDeployed, Converter={StaticResource BoolToBrushConverter}}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        ToolTip="Shows whether runtime hooks (sl.interposer.dll / dxgi.dll) and aetherpulse.ini are currently active in the game's executable directory.">
                                                    <TextBlock Text="{Binding IsHookDeployed, Converter={StaticResource BoolToStatusTextConverter}, ConverterParameter='Deployed:Inactive'}" 
                                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                </Border>

                                                <!-- Anti-Cheat Protected Pill -->
                                                <Border Background="#3D1418" BorderBrush="#E01E26" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasAntiCheatWarning, Converter={StaticResource BoolToVisConverter}}"
                                                        ToolTip="Multiplayer protection detected. Injecting custom proxy DLLs online may trigger game security flags. Recommended strictly for offline/single-player play.">
                                                    <TextBlock Text="⚠️ Anti-Cheat" FontSize="11.5" FontWeight="Bold" Foreground="#FF7B85" />
                                                </Border>

                                                <!-- Running Status Pill -->
                                                <Border Background="#1C2F24" BorderBrush="#238636" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" 
                                                        Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisConverter}}"
                                                        ToolTip="Game process is actively running and receiving presentation hooks.">
                                                    <TextBlock Text="IN-GAME" FontSize="11.5" FontWeight="Bold" Foreground="#3FB950" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Target Hook DLL Tag -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Hook Proxy: " FontSize="12.5" Foreground="#8B949E" />
                                                <TextBlock Text="{Binding ProxyDisplayLabel, FallbackValue='sl.interposer.dll (Blackwell Spoof)'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6EDF3" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons Bar -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="⚙ Tune" Style="{StaticResource BtnSecondary}" Height="34" Padding="14,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.TuneGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="Deploy" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0" FontSize="13" FontWeight="Bold" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.DeployCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="Uninstall" Style="{StaticResource BtnSecondary}" Height="34" Padding="12,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.RemoveHookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="▶ Launch" Style="{StaticResource BtnSecondary}" Height="34" Padding="14,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="✕" Style="{StaticResource BtnDanger}" Height="34" Width="34" FontSize="14" Padding="0"
                                                    Command="{Binding DataContext.DeleteGameFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Details Section: Executable Path & Feature Capabilities -->
                                    <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,10"
                                            ToolTip="{Binding ExecutablePath}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Path text -->
                                            <TextBlock Grid.Column="0" Text="{Binding ExecutablePath}" Foreground="#A0AEC0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            
                                            <!-- Capability tag -->
                                            <Border Grid.Column="1" Background="#161B26" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="12,0,0,0"
                                                    Visibility="{Binding HasCapabilityBadge, Converter={StaticResource BoolToVisConverter}}"
                                                    ToolTip="DXGI Presentation Pacing capabilities verified. Supports high-precision frametime synchronization.">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡ " Foreground="#58A6FF" FontSize="11.5" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Capability.BadgeText}" FontSize="12" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Full-Width Conflict Warning Strip -->
                                    <Border Background="#201507" BorderBrush="#9E6A03" BorderThickness="1" CornerRadius="5" Padding="14,10"
                                            Visibility="{Binding HasOptiScalerConflict, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OptiScalerWarningMessage}" Foreground="#E3B341" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <Button Grid.Column="1" Content="Clean Conflicting Mods" Style="{StaticResource BtnWarning}" Height="30" Padding="14,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.CleanConflictsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Removes older mod proxy files without touching your ReShade setup." />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Modals -->
        <Grid Background="#B0000000" Visibility="{Binding ValidationFailureModalVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="100">
            <Border Background="#161A22" BorderBrush="#E01E26" BorderThickness="1.5" CornerRadius="8" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="⚠️ Compatibility Verification Failed" FontSize="16" FontWeight="Bold" Foreground="#FF6E6E" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ValidationTargetName, StringFormat='Target: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,12" />
                    <TextBlock Text="The selected game does not meet all required injection criteria:" Foreground="#C9D1D9" FontSize="13" Margin="0,0,0,14" />

                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Direct3D 12 (D3D12) API" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓ Passed (D3D12 Detected)" Foreground="#3FB950" FontWeight="Bold" FontSize="12.5" Visibility="{Binding IsDx12Passed, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="✗ Failed (Requires DirectX 12)" Foreground="#FF6E6E" FontWeight="Bold" FontSize="12.5" Visibility="{Binding IsDx12Passed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Separator Background="#30363D" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DLSS / Streamline Hook" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✓ Passed (DLSS/Streamline Found)" Foreground="#3FB950" FontWeight="Bold" FontSize="12.5" Visibility="{Binding IsDlssPassed, Converter={StaticResource BoolToVisConverter}}" />
                                    <TextBlock Text="✗ Failed (Missing nvngx_dlss.dll / Streamline)" Foreground="#FF6E6E" FontWeight="Bold" FontSize="12.5" Visibility="{Binding IsDlssPassed, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AetherPulse frame pacing and Ray Regeneration intercept Direct3D 12 swapchains and Streamline buffer tags. Without these, runtime injection may not take effect." Foreground="#8B949E" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel Import" Style="{StaticResource BtnSecondary}" Height="36" FontSize="13" Command="{Binding CancelValidationModalCommand}" />
                        <Button Grid.Column="2" Content="Force Add Anyway" Style="{StaticResource BtnDanger}" Height="36" FontSize="13" Command="{Binding ConfirmForceAddGameCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#B0000000" Visibility="{Binding AntiCheatModalVisible, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="110">
            <Border Background="#161A22" BorderBrush="#E01E26" BorderThickness="1.5" CornerRadius="8" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="🚨 HIGH RISK: ONLINE / ANTI-CHEAT PROTECTED GAME" FontSize="15" FontWeight="Bold" Foreground="#FF6E6E" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding AntiCheatTargetGameName, StringFormat='Target: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" />
                        <Border Background="#3D1418" BorderBrush="#E01E26" BorderThickness="1" CornerRadius="4" Padding="7,2">
                            <TextBlock Text="{Binding AntiCheatDetectedSystem, StringFormat='System: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FF7B85" />
                        </Border>
                    </StackPanel>

                    <Border Background="#0D1117" BorderBrush="#3D1418" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Explicit Ban Warning:" FontWeight="Bold" Foreground="#FF7B85" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock Text="Injecting runtime proxy DLLs (version.dll, dxgi.dll) into games with active anti-cheat systems can be flagged as unauthorized third-party software and may result in an immediate, permanent ACCOUNT BAN." Foreground="#E6EDF3" FontSize="12" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Developer Liability Waiver:" FontWeight="Bold" Foreground="#8B949E" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock Text="AetherPulse is strictly built for single-player and offline rendering enhancements. Stanorius Software assumes ZERO responsibility or liability for account suspensions, penalties, or bans incurred on multiplayer servers." Foreground="#8B949E" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding AntiCheatLiabilityAcknowledged, Mode=TwoWay}" Margin="0,0,0,20" Cursor="Hand">
                        <TextBlock Text="I understand the severe risk of account bans and assume full personal responsibility." Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                    </CheckBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel (Recommended / Safe)" Style="{StaticResource BtnSecondary}" Height="38" FontSize="13" Command="{Binding CancelAntiCheatModalCommand}" />
                        <Button Grid.Column="2" Content="Proceed at Own Risk" Style="{StaticResource BtnDanger}" Height="38" FontSize="13" IsEnabled="{Binding AntiCheatLiabilityAcknowledged}" Command="{Binding ConfirmAntiCheatDeployCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
            <!-- Library Footer Hazard Warning Beacon Note at Bottom -->
        <Border x:Name="HazardBorder" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="68" BorderThickness="2" CornerRadius="8" Background="#0D1117" Padding="16,10" Margin="12,16,12,8">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1E27" Offset="0.0"/>
                    <GradientStop Color="#0044FF" Offset="0.5"/>
                    <GradientStop Color="#FF1E27" Offset="1.0"/>
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="AnimatedGradientRotate" CenterX="0.5" CenterY="0.5" Angle="0"/>
                    </LinearGradientBrush.RelativeTransform>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="GlowingShadow" Color="#FF1E27" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <!-- Clockwise Rotating Border Gradient -->
                            <DoubleAnimation Storyboard.TargetName="AnimatedGradientRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:3.5"/>
                            <!-- Glow Hue Oscillation Red to Blue -->
                            <ColorAnimation Storyboard.TargetName="GlowingShadow"
                                            Storyboard.TargetProperty="Color"
                                            From="#FF1E27" To="#0055FF" Duration="0:0:1.75" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Dual Red & Blue Alternating Police Strobe Lights -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Red Strobe Beacon -->
                    <Border x:Name="RedBeacon" Width="14" Height="22" CornerRadius="4" Background="#FF1744" Margin="0,0,4,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF1744" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RedBeacon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.1" Duration="0:0:0.18" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Blue Strobe Beacon (Opposite Phase) -->
                    <Border x:Name="BlueBeacon" Width="14" Height="22" CornerRadius="4" Background="#0066FF">
                        <Border.Effect>
                            <DropShadowEffect Color="#0066FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BlueBeacon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.1" To="1.0" Duration="0:0:0.18" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </StackPanel>

                <!-- Warning Notice Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="HAZARD WARNING: ONLINE &amp; ANTI-CHEAT PROTECTED TITLES" 
                               FontWeight="Bold" FontSize="12" Foreground="#FF6E6E" Margin="0,0,0,2"/>
                    <TextBlock Text="D3D12 proxy injection (version.dll, dxgi.dll) is strictly intended for offline &amp; single-player titles. Online games with anti-cheat software (EAC, BattlEye, Vanguard) may flag custom proxy DLLs. Always verify game compatibility before deploying." 
                               FontSize="11" Foreground="#C9D1D9" TextWrapping="Wrap" LineHeight="15"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>




