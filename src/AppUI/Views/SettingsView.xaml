<UserControl x:Class="AppUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="1050" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings &amp; Accreditations" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Manage background execution, overlay HUD, system tray, and attributions." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#16233B" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Permissions: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PermissionsDisplayLabel, FallbackValue='STANDARD'}" 
                                       FontWeight="Bold" FontSize="11.5" Foreground="{Binding PermissionsColorBrush, FallbackValue='#E3B341'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="10,4" Margin="0,0,8,0"
                            Command="{Binding InstallProxyToGameCommand}"
                            ToolTip="Installs version.dll and default INI configuration into a target game folder.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Install Proxy to Game" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="10,4"
                            Command="{Binding RestartAsAdminCommand}"
                            ToolTip="Relaunches AetherPulse with full administrator rights to deploy into protected Program Files directories.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Relaunch as Admin" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Card 1: Telemetry HUD & In-Game Overlay -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Telemetry HUD &amp; In-Game Overlay" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Show Floating Telemetry Overlay Toggle -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Show Desktop / Floating Telemetry HUD" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Displays the real-time FPS, frame-time pacing, jitter %, and latency metering widget (Shortcut: Ctrl + Shift + [ )." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding IsOverlayVisible, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Screen Position Selection -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HUD Screen Position" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Instantly snap the floating telemetry overlay to a selected screen corner." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="↖ Top Left" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2" Margin="0,0,5,0"
                                    Command="{Binding SetOverlayPositionCommand}" CommandParameter="Top Left" />
                            <Button Content="↗ Top Right" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2" Margin="0,0,5,0"
                                    Command="{Binding SetOverlayPositionCommand}" CommandParameter="Top Right" />
                            <Button Content="↙ Bottom Left" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2" Margin="0,0,5,0"
                                    Command="{Binding SetOverlayPositionCommand}" CommandParameter="Bottom Left" />
                            <Button Content="↘ Bottom Right" Style="{StaticResource BtnSecondary}" Height="28" Padding="8,2"
                                    Command="{Binding SetOverlayPositionCommand}" CommandParameter="Bottom Right" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Telemetry Note Callout -->
                    <Border Background="#161B26" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🖥️" FontSize="14" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="1" Text="The HUD can also be pinned, dragged across monitors, or adjusted for opacity using the top-right slider on the title bar." TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: Application Lifecycle & Tray Preferences -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Application Lifecycle &amp; Background Execution" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Start AetherPulse with Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically launches AetherPulse on system startup to resume game hooks and telemetry." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Minimize to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Hides the application window to the taskbar notification area when minimized." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Close Window to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Clicking the close button hides the window while keeping frame pacing hooks and telemetry active." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Start Minimized to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Launches directly into the notification area without opening the main window." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartMinimized, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Mod Chaining & Compatibility -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Mod Chaining &amp; Compatibility (ReShade / RenoDX / OptiScaler)" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Enable Multi-Mod Proxy Chaining" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically detects and chain-loads foreign dxgi_chain.dll, ReShade64.dll, or OptiScaler.dll without overwriting existing graphics mods." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding EnableProxyChaining, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="#161B26" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡" FontSize="14" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="1" Text="Allows AetherPulse frame pacing and FSR Ray Regeneration to run alongside RenoDX HDR tone-mapping and ReShade post-processing shaders without DLL file conflicts." TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 4: Legal Disclaimers & Trademarks -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Legal Disclaimers &amp; Trademark Accreditations" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <Border Background="#121620" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AMD &amp; FidelityFX™ Notice" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="AMD, Radeon, FidelityFX, FSR, and FreeSync are registered trademarks of Advanced Micro Devices, Inc. AetherPulse is an independent optimization tool and is not officially endorsed, sponsored, or manufactured by AMD." 
                                       Style="{StaticResource TextSubheader}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <Border Background="#121620" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Open Source Libraries &amp; Attributions" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="• Theme &amp; Design: Inspired by modern AMD FidelityFX™ &amp; Radeon™ software design language.&#x0a;• AMD FidelityFX SDK — MIT License&#x0a;• MinHook (The Minimalistic API Hooking Library) — Tsuda Kageyu (BSD-2-Clause)&#x0a;• Community Toolkit MVVM &amp; .NET Foundation — MIT License&#x0a;• Community OptiScaler pipeline inspirations." 
                                       Style="{StaticResource TextSubheader}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Developer & Project Info Card -->
            <Border Background="#15181E" BorderBrush="#272C35" BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="Project Attributions &amp; Author"/>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="0" Text="Developed by:" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF424D" Grid.Column="1" Text="Stanorius Software ©"/>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="0" Text="Architecture:" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Grid.Column="1" Text="DirectX 12 Swapchain Pacing, FSR Upscaling, Multi-Frame Generation &amp; FidelityFX Ray Regeneration / Radiance Cache Bridge"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>