<UserControl x:Class="AppUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="850" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings &amp; Accreditations" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Manage background execution, system tray integration, and view project attributions." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Process Elevation Status & Elevation Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#16233B" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="6" 
                            Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Permissions: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="ADMINISTRATOR" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StatusGreenGlowBrush}" 
                                       Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource BoolToVisConverter}}" />
                            <TextBlock Text="STANDARD USER" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StatusYellowBrush}" 
                                       Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Relaunch as Admin Button -->
                    <Button Style="{StaticResource BtnSecondary}" Height="30" Padding="10,4"
                            Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource InverseBoolToVisConverter}}"
                            ToolTip="Relaunches AetherPulse with full administrator rights to deploy into protected Program Files directories.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Relaunch as Admin" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Card 1: Application Lifecycle & Tray Preferences -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Application Lifecycle &amp; Background Execution" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Start AetherPulse with Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically launches AetherPulse on system startup to resume game hooks and telemetry." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Minimize to Tray -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Minimize to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Hides the application window to the taskbar notification area when minimized." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Close to Tray -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Close Window to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Clicking the close button hides the window while keeping frame pacing hooks and telemetry active." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Start Minimized -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Start Minimized to System Tray" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Launches directly into the notification area without opening the main window." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartMinimized, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Mod Chaining & Compatibility -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Mod Chaining &amp; Compatibility (ReShade / RenoDX / OptiScaler)" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Proxy Chaining Toggle -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Enable Multi-Mod Proxy Chaining" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically detects and chain-loads foreign dxgi_chain.dll, ReShade64.dll, or OptiScaler.dll without overwriting existing graphics mods." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding EnableProxyChaining, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- AMD Red Info Callout -->
                    <Border Background="{StaticResource Brush.Callout.Background}" BorderBrush="{StaticResource Brush.Callout.Border}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Glowing Bulb / Info Icon -->
                            <Path Data="M8,1.5 C5,1.5 2.5,3.9 2.5,6.9 C2.5,8.8 3.5,10.4 5,11.3 L5,12.5 C5,12.8 5.2,13 5.5,13 L10.5,13 C10.8,13 11,12.8 11,12.5 L11,11.3 C12.5,10.4 13.5,8.8 13.5,6.9 C13.5,3.9 11,1.5 8,1.5 Z M6,14 L10,14 L10,14.5 C10,14.8 9.8,15 9.5,15 L6.5,15 C6.2,15 6,14.8 6,14.5 Z" Fill="{StaticResource Brush.Callout.Icon}" Grid.Column="0" Height="14" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center" Width="14"/>

                            <!-- Callout Text -->
                            <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.Callout.Text}" Grid.Column="1" Text="Allows AetherPulse frame pacing and FSR Ray Regeneration to run alongside RenoDX HDR tone-mapping and ReShade post-processing shaders without DLL file conflicts." TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Legal Disclaimers & Trademarks -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Legal Disclaimers &amp; Trademark Accreditations" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- AMD Disclaimer -->
                    <Border Background="#121620" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AMD &amp; FidelityFX™ Notice" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="AMD, Radeon, FidelityFX, FSR, and FreeSync are registered trademarks of Advanced Micro Devices, Inc. AetherPulse is an independent optimization tool and is not officially endorsed, sponsored, or manufactured by AMD." 
                                       Style="{StaticResource TextSubheader}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <!-- NVIDIA Disclaimer -->
                    <Border Background="#121620" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="NVIDIA® &amp; Streamline™ Notice" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="NVIDIA, GeForce, DLSS, and Streamline are trademarks of NVIDIA Corporation. Streamline API hooks are utilized under standard open-source API interposer compatibility patterns to provide seamless interoperability with FidelityFX compute shaders." 
                                       Style="{StaticResource TextSubheader}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <!-- Open Source Licenses -->
                    <Border Background="#121620" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Open Source Libraries &amp; Attributions" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="• Theme &amp; Design: Inspired by the AMD FidelityFX™ Redstone &amp; Radeon™ gaming design language. UI visual assets and shaders authored under MIT and Open-Source compatibility terms.&#x0a;• AMD FidelityFX SDK — MIT License&#x0a;• MinHook (The Minimalistic API Hooking Library) — Tsuda Kageyu (BSD-2-Clause)&#x0a;• Community Toolkit MVVM &amp; .NET Foundation — MIT License&#x0a;• Community OptiScaler pipeline inspirations." 
                                       Style="{StaticResource TextSubheader}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Developer & Project Info Card -->
            <Border Background="#15181E" BorderBrush="#272C35" BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#F0F3F6" Margin="0,0,0,8" Text="Project Attributions &amp; Author"/>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" Grid.Column="0" Text="Developed by:" Width="110"/>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF424D" Grid.Column="1" Text="Stanorius Software ©"/>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" Grid.Column="0" Text="Architecture:" Width="110"/>
                        <TextBlock FontSize="12" Foreground="#C9D1D9" Grid.Column="1" Text="DirectX 12 Swapchain Pacing, FSR Upscaling, Multi-Frame Generation &amp; FidelityFX Ray Regeneration / Radiance Cache Bridge"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
