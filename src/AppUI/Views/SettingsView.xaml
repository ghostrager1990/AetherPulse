<UserControl x:Class="AppUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             FontFamily="Bahnschrift"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="1150" d:DesignWidth="850">

    <UserControl.Resources>
        <Style x:Key="FpsSelectBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#162235"/>
                    <Setter Property="Foreground" Value="#58A6FF"/>
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Settings &amp; Accreditations" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Manage background execution, overlay HUD, system tray, and attributions." 
                               FontSize="13" Foreground="#8B949E" Margin="0,4,0,0" LineHeight="17" />
                </StackPanel>

            </Grid>

            <!-- Card 1: Telemetry HUD & In-Game Overlay -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Telemetry HUD &amp; In-Game Overlay" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <!-- Show HUD Toggle -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Show Desktop / Floating Telemetry HUD" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Displays the real-time FPS, frame-time pacing, jitter %, and latency metering widget (Shortcut: Ctrl + Shift + [)." 
                                       FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ShowFloatingHud, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- HUD Screen Position Strip -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="HUD Screen Position" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Instantly snap the floating telemetry overlay to a selected screen corner." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Top Left" Style="{StaticResource FpsSelectBtn}" Height="30" Padding="10,0" Margin="0,0,6,0"
                                    Tag="{Binding IsTopLeftActive}"
                                    Command="{Binding SetHudPositionCommand}" CommandParameter="Top Left" />
                            <Button Content="Top Right" Style="{StaticResource FpsSelectBtn}" Height="30" Padding="10,0" Margin="0,0,6,0"
                                    Tag="{Binding IsTopRightActive}"
                                    Command="{Binding SetHudPositionCommand}" CommandParameter="Top Right" />
                            <Button Content="Bottom Left" Style="{StaticResource FpsSelectBtn}" Height="30" Padding="10,0" Margin="0,0,6,0"
                                    Tag="{Binding IsBottomLeftActive}"
                                    Command="{Binding SetHudPositionCommand}" CommandParameter="Bottom Left" />
                            <Button Content="Bottom Right" Style="{StaticResource FpsSelectBtn}" Height="30" Padding="10,0" Margin="0"
                                    Tag="{Binding IsBottomRightActive}"
                                    Command="{Binding SetHudPositionCommand}" CommandParameter="Bottom Right" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Hardware Sensor Polling Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Hardware Sensor Polling (AMD ADL / GPU Sensors)"/>
                            <TextBlock FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" Text="Directly poll AMD Adrenalin / GPU performance registers for GPU load and hardware sensor metrics." TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" IsChecked="{Binding EnableHardwareSensorPolling, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Info Tip Box -->
                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <TextBlock Text="💡 The main window can also be pinned, dragged across monitors, or adjusted for opacity using the top-right slider on the title bar." 
                                   FontSize="11.5" Foreground="#8B949E" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: Application Lifecycle & Background Execution -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Application Lifecycle &amp; Background Execution" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <!-- Option 1 -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Start AetherPulse with Windows" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically launches AetherPulse on system startup to resume game hooks and telemetry." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Option 2 -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Minimize to System Tray" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Hides the application window to the taskbar notification area when minimized." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Option 3 -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Close Window to System Tray" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Clicking the close button hides the window while keeping frame pacing hooks and telemetry active." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#30363D" Margin="0,0,0,14" />

                    <!-- Option 4 -->
                    <Grid>
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Start Minimized to System Tray" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Launches directly into the notification area without opening the main window." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding StartMinimized, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Mod Chaining & Compatibility -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mod Chaining &amp; Compatibility (ReShade / RenoDX / OptiScaler)" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Enable Multi-Mod Proxy Chaining" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically detects and chain-loads foreign dxgi_chain.dll, ReShade64.dll, or OptiScaler.dll without overwriting existing graphics mods." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding EnableProxyChaining, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <TextBlock Text="💡 Allows AetherPulse frame pacing to run alongside RenoDX HDR tone-mapping and ReShade post-processing shaders without DLL file conflicts." 
                                   FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 4: Open Source Attributions & Accreditations -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Open Source Libraries &amp; Attributions" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="• Intel PresentMon (Presentation Telemetry &amp; Frame Timing Capture) - MIT License" FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,3" />
                            <TextBlock Text="• MinHook (The Minimalistic API Hooking Library) - Tsuda Kageyu (BSD-2-Clause)" FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,3" />
                            <TextBlock Text="• Community Toolkit MVVM &amp; .NET Foundation - MIT License" FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,3" />
                            <TextBlock Text="• Community OptiScaler &amp; ReShade proxy chaining architecture inspirations" FontSize="11.5" Foreground="#8B949E" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <!-- Card 5: Project Attributions & Author -->
            <Border Background="#161A22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="Project Attributions &amp; Author" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Developed by: " FontSize="12" Foreground="#8B949E" />
                        <TextBlock Text="Stanorius Software ©" FontSize="12" FontWeight="Bold" Foreground="#FF6E6E" />
                    </StackPanel>
                    <TextBlock Text="Architecture: DirectX 12 Swapchain Pacing, Microsecond Waitable Timers &amp; Optical-Flow Sub-Frame Cadence Synchronization" FontSize="11.5" Foreground="#8B949E" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
