<UserControl x:Class="AppUI.Views.FSRTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FSRTuningViewModel}"
             d:DesignHeight="850" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Header with Profile Selector ComboBox -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="FSR 4 Upscaling &amp; Sharpening Pipeline" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Tune post-upscale FidelityFX RCAS sharpening, sampler MIP LOD bias, and DRS render scale floor." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Active Profile Selector ComboBox -->
                <ComboBox ItemsSource="{Binding DataContext.AvailableTuningProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.ActiveTuningProfile, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="GameName"
                          Style="{StaticResource DarkComboBox}"
                          Width="250" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- In-Game Setup Note Callout -->
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <StackPanel Width="740">
                        <TextBlock Text="In-Game Setup Note:" FontWeight="Bold" Foreground="#58A6FF" FontSize="12.5" Margin="0,0,0,2" />
                        <TextBlock Text="For games where Ray Reconstruction requires DLSS to be selected in the settings menu, select 'DLSS' in-game. AetherPulse automatically intercepts DLSS calls and executes the FSR 4 upscaling engine and FidelityFX Ray Regeneration under the hood." 
                                   Foreground="#C9D1D9" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 0: FSR 4 Upscaler & Native AA Mode -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="AMD FidelityFX Upscaler &amp; Anti-Aliasing" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12" />

                    <!-- Native AA Switch -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Native AA (FSR Native Mode)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Renders at native display resolution while executing FSR temporal reconstruction for pristine anti-aliasing without resolution scaling." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Executes temporal anti-aliasing at 1.0x native render scale for maximum edge stability." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.NativeAA}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Reactive Mask Optimization Switch -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Reactive Mask Optimization" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Generates a dynamic reactive mask to protect fast-moving UI elements, particle effects, and spell trails from temporal ghosting." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Automatically excludes transparent layers and 2D particle channels from history accumulation." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.ReactiveMask}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 1: FidelityFX RCAS Sharpening Override -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="FidelityFX RCAS Sharpening Override" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12" />

                    <!-- Enable RCAS Override Switch -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Override In-Game Sharpening (RCAS)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Injects an AMD FidelityFX RCAS compute pass over the post-upscaled back-buffer to enhance edge contrast without creating ringing halos." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Dispatches a contrast-adaptive compute pass immediately prior to swapchain Present." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.EnableRCASOverride}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Sharpness Slider and Presets -->
                    <StackPanel Margin="0,0,0,6">
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="RCAS Sharpness Strength" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Higher values sharpen micro-details. Values around 0.30 - 0.40 provide high crispness with zero oversharpening artifacts." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Soft (0.15)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding ApplySoftPresetCommand}" />
                                <Button Content="Balanced (0.35)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding ApplyBalancedPresetCommand}" />
                                <Button Content="Ultra Sharp (0.60)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,8,0"
                                        Command="{Binding ApplyUltraSharpPresetCommand}" />
                                <TextBlock Text="{Binding ActiveProfile.Sharpness, StringFormat={}{0:F2}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Width="36" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ActiveProfile.Sharpness}" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding RecommendedSharpnessText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Texture Clarity & MIP LOD Bias -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Texture Clarity &amp; Mipmap LOD Bias" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Auto LOD Bias Toggle -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Auto-Calculate Mipmap LOD Bias" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Automatically offsets texture mipmap levels using -0.5 * log2(UpscaleRatio) to ensure texture sharpness matches native display resolution." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Applies optimal negative bias dynamically based on active render scale." Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding IsAutoMipLod, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Manual LOD Bias Slider -->
                    <StackPanel Margin="0,0,0,6" Opacity="{Binding LodBiasControlsOpacity}">
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Manual MIP LOD Bias" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Negative values force the GPU to sample higher resolution texture mip levels. -0.58 corresponds to Quality mode; -1.00 corresponds to Balanced mode." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ManualMipLodBias, StringFormat={}{0:F2}}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="-2.0" Maximum="0.0" Value="{Binding ManualMipLodBias, Mode=TwoWay}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding RecommendedLodBiasText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Particle & Transparency Ghosting (Reactive Mask) -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Particle &amp; Transparency Ghosting (Reactive Mask)" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <StackPanel Margin="0,0,0,6">
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Reactive Mask Sensitivity" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Controls sensitivity for reactive history rejection. Prevents alpha particles, spell trails, and smoke from ghosting across high-contrast backgrounds." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveProfile.ReactiveMaskSensitivity, StringFormat={}{0:F2}}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ActiveProfile.ReactiveMaskSensitivity}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding RecommendedReactiveMaskText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Dynamic Resolution Scaling (DRS) Floor -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel Opacity="{Binding DrsFloorOpacity}">
                    <TextBlock Text="Dynamic Resolution Scaling (DRS) Floor" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <StackPanel Margin="0,0,0,6">
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Minimum Internal Render Scale" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Prevents dynamic resolution from dropping below this threshold to protect image clarity during intense action sequences." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Quality (67%)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                        IsEnabled="{Binding IsDrsFloorEnabled}"
                                        Command="{Binding SetDrsQualityCommand}" />
                                <Button Content="Balanced (59%)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                        IsEnabled="{Binding IsDrsFloorEnabled}"
                                        Command="{Binding SetDrsBalancedCommand}" />
                                <Button Content="Performance (50%)" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,1" FontSize="11" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsDrsFloorEnabled}"
                                        Command="{Binding SetDrsPerformanceCommand}" />
                                <TextBlock Text="{Binding DrsFloorDisplayText}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" 
                                Value="{Binding ActiveProfile.ClampMinRenderScale}" IsEnabled="{Binding IsDrsFloorEnabled}" Margin="0,2,0,4" />
                        <TextBlock Text="{Binding RecommendedDrsFloorText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AMD Red Info Callout -->
            <Border Background="{StaticResource Brush.Callout.Background}" BorderBrush="{StaticResource Brush.Callout.Border}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Glowing Bulb / Info Icon -->
                    <Path Data="M8,1.5 C5,1.5 2.5,3.9 2.5,6.9 C2.5,8.8 3.5,10.4 5,11.3 L5,12.5 C5,12.8 5.2,13 5.5,13 L10.5,13 C10.8,13 11,12.8 11,12.5 L11,11.3 C12.5,10.4 13.5,8.8 13.5,6.9 C13.5,3.9 11,1.5 8,1.5 Z M6,14 L10,14 L10,14.5 C10,14.8 9.8,15 9.5,15 L6.5,15 C6.2,15 6,14.8 6,14.5 Z" Fill="{StaticResource Brush.Callout.Icon}" Grid.Column="0" Height="14" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center" Width="14"/>

                    <!-- Callout Text -->
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.Callout.Text}" Grid.Column="1" Text="AMD FidelityFX RCAS provides edge-preserving sharpening without ringing, while negative Mipmap LOD bias ensures texture filtering clarity matches native display resolution." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
