<UserControl x:Class="AppUI.Views.RayRegenTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RayRegenTuningViewModel}"
             d:DesignHeight="850" d:DesignWidth="850">
    <Grid>
        <!-- Main Content Scroll Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">

                <!-- Header with Profile Selector ComboBox -->
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ray Regeneration &amp; Denoiser Bridge" Style="{StaticResource TextHeader}" />
                        <TextBlock Text="Intercepts game engine ray tracing buffers and executes AMD FidelityFX spatial-temporal wavelet denoising passes." 
                                   Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Active Profile Selector ComboBox -->
                    <ComboBox ItemsSource="{Binding DataContext.AvailableTuningProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.ActiveTuningProfile, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="GameName"
                              Style="{StaticResource DarkComboBox}"
                              Width="250" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Presets Action Bar (4 Clean Buttons) -->
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,10,0" Text="⚡ Presets:" VerticalAlignment="Center"/>

                    <Button Command="{Binding OpenPresetModalCommand}" CommandParameter="Performance" Content="🚀 High Performance" FocusVisualStyle="{x:Null}" Margin="0,0,8,0" Padding="12,5" Style="{StaticResource BtnSecondary}" />
                    <Button Command="{Binding OpenPresetModalCommand}" CommandParameter="Balanced" Content="⚡ Balanced" FocusVisualStyle="{x:Null}" Margin="0,0,8,0" Padding="12,5" Style="{StaticResource BtnSecondary}" />
                    <Button Command="{Binding OpenPresetModalCommand}" CommandParameter="Ultra" Content="🔥 Ultra Ray Tracing" FocusVisualStyle="{x:Null}" Margin="0,0,8,0" Padding="12,5" Style="{StaticResource BtnSecondary}" />
                    <Button Command="{Binding OpenPresetModalCommand}" CommandParameter="Reset" Content="↺ Reset to Default" FocusVisualStyle="{x:Null}" Padding="12,5" Style="{StaticResource BtnSecondary}" />
                </StackPanel>

                <!-- Card 1: Master Denoiser Toggle -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Text="Ray Reconstruction Master Switch" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12" />

                        <!-- Enable Ray Regen Switch -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Enable FidelityFX Ray Reconstruction" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Intercepts raw ray tracing radiance buffers from DLSS-D games and applies AMD FidelityFX denoising passes." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Overrides NVIDIA DLSS-D tags and executes D3D12 wavelet compute passes." 
                                           Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.RayRegenEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Streamline Spoof Status Blurb -->
                        <Border Background="#121620" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓ " Foreground="#3FB950" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Streamline Spoof Active: Unlocks native in-game Ray Reconstruction toggle for AMD GPUs and routes lighting buffers to FidelityFX compute shaders." 
                                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 1.5: Modular FidelityFX NRC & Denoising Engines -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Text="Modular FidelityFX NRC &amp; Denoising Engines" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12" />

                        <!-- Neural Radiance Caching (NRC) -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Neural Radiance Caching (NRC)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Activates amd_fidelityfx_radiancecache_dx12.dll to accelerate real-time multi-bounce indirect lighting and irradiance probe queries." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Accelerates diffuse GI and multi-bounce ray queries via hardware radiance caching." 
                                           Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.NeuralRadianceCache}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                        <!-- Reflection Denoiser -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Reflection Denoiser" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Filters noisy specular reflections using surface roughness thresholds and normal gating." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Cleans up grain and noise on glossy and mirror-like surfaces." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.DenoiseReflections}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                        <!-- Shadow Denoiser -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Shadow &amp; Ambient Occlusion Denoiser" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Smooths ray-traced soft shadow penumbras and RTAO contact shadows." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Denoises variable penumbra contact shadows and ambient occlusion." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.DenoiseShadows}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                        <!-- Glossy Radiance Filter -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Glossy Radiance Filter" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Adaptive filter pass preserving highlights on metallic and rough surfaces." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Preserves specular roughness highlights and prevents light smearing." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.GlossyRadianceFilter}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: FidelityFX Radiance & Signal Processing -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Text="FidelityFX Radiance &amp; Signal Processing" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                        <!-- Auto-Exposure Clamping -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="HDR Auto-Exposure Clamping" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Clamps floating-point specular spikes to prevent light flickering in ray-traced reflections." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Prevents floating point overflow and extreme light flickering in reflections." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.ForceAutoExposure}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                        <!-- Color Space Correction -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Perceptual Non-Linear Color Correction" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Applies a logarithmic tonemap curve prior to wavelet spatial filtering to eliminate dark-region grain." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Applies log/tonemap curve prior to filtering and inverts afterwards." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.ColorSpaceCorrect}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                        <!-- Disocclusion Ghosting Filter -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Disocclusion Ghosting Filter" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Optimizes history accumulation on newly revealed geometry during fast camera movement." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Resets temporal weight across sharp depth disocclusions to eliminate smearing." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.DisocclusionFilterEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Roughness & Surface Properties -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Text="Surface Gating &amp; Filtering Thresholds" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                        <!-- Roughness Threshold -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Roughness Threshold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Reflections on surfaces sharper than this threshold bypass spatial filtering to preserve mirror clarity." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProfile.RoughnessThreshold, StringFormat={}{0:F2}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ActiveProfile.RoughnessThreshold}" Margin="0,2,0,4" />
                            <TextBlock Text="Recommended: 0.50 (Balances glossy reflections and sharp mirrors)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Spatial Filter Passes -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Spatial Wavelet Iterations" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Number of 5x5 à-trous filter passes. Higher values eliminate ray grain and noise at a modest GPU cost." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProfile.SpatialFilterPasses, StringFormat={}{0} Passes}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" 
                                    Value="{Binding ActiveProfile.SpatialFilterPasses}" Margin="0,2,0,4" />
                            <TextBlock Text="Recommended: 2 Passes (Optimal noise reduction vs performance)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Temporal History Weight -->
                        <StackPanel Margin="0,0,0,6">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Temporal History Weight" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Weight of previous frame ray samples (0.0 to 1.0). Higher weights eliminate noise but may increase blur during fast movement." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProfile.TemporalWeight, StringFormat={}{0:F2}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding ActiveProfile.TemporalWeight}" Margin="0,2,0,4" />
                            <TextBlock Text="Recommended: 0.85 (Balances stability and camera responsiveness)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Bilateral Edge-Stopping Weights -->
                <Border Style="{StaticResource CardContainer}">
                    <StackPanel>
                        <TextBlock Text="Bilateral Edge-Stopping Weights" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                        <!-- Depth Sigma -->
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Depth Sensitivity (Sigma)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Controls geometry edge-stopping. Prevents denoiser color bleeding across depth discontinuities." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProfile.DepthSigma, StringFormat={}{0:F2}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0.1" Maximum="5.0" Value="{Binding ActiveProfile.DepthSigma}" Margin="0,2,0,4" />
                            <TextBlock Text="Recommended: 1.00 (Standard bilateral edge preservation)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Normal Sigma -->
                        <StackPanel Margin="0,0,0,6">
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Normal Sensitivity Exponent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Preserves surface crevices and geometric curvature details during spatial filtering." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveProfile.NormalSigma, StringFormat={}{0:F1}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="8.0" Maximum="128.0" Value="{Binding ActiveProfile.NormalSigma}" Margin="0,2,0,4" />
                            <TextBlock Text="Recommended: 64.0 (Preserves fine geometric details)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AMD Red Info Callout -->
                <Border Background="{StaticResource Brush.Callout.Background}" BorderBrush="{StaticResource Brush.Callout.Border}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Glowing Bulb / Info Icon -->
                        <Path Data="M8,1.5 C5,1.5 2.5,3.9 2.5,6.9 C2.5,8.8 3.5,10.4 5,11.3 L5,12.5 C5,12.8 5.2,13 5.5,13 L10.5,13 C10.8,13 11,12.8 11,12.5 L11,11.3 C12.5,10.4 13.5,8.8 13.5,6.9 C13.5,3.9 11,1.5 8,1.5 Z M6,14 L10,14 L10,14.5 C10,14.8 9.8,15 9.5,15 L6.5,15 C6.2,15 6,14.8 6,14.5 Z" Fill="{StaticResource Brush.Callout.Icon}" Grid.Column="0" Height="14" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center" Width="14"/>

                        <!-- Callout Text -->
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Callout.Text}" 
                                   Text="Intercepts game engine ray tracing lighting buffers and applies AMD FidelityFX spatial-temporal denoising filters." TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" LineHeight="17"
                                   Text="In Simple Terms: Real-time ray tracing creates grainy, noisy lighting and reflections. Ray Regeneration acts as an intelligent filter that cleans up this speckled noise across frames while keeping fine object edges sharp, delivering clean and flicker-free ray-traced visuals." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

        <!-- Preset Confirmation Modal Dialog Overlay -->
        <Grid Background="#B0000000" 
              Visibility="{Binding IsPresetModalVisible, Converter={StaticResource BoolToVisConverter}}"
              Panel.ZIndex="100">
            <Border Background="#15181E" 
                    BorderBrush="#E01E26" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    MaxWidth="460" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Padding="22">
                <StackPanel>
                    <!-- Modal Header -->
                    <TextBlock Text="{Binding ModalTitle}" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#FF424D" 
                               Margin="0,0,0,10" />

                    <!-- Modal Description -->
                    <TextBlock Text="{Binding ModalDescription}" 
                               Foreground="#C9D1D9" 
                               FontSize="13" 
                               TextWrapping="Wrap" 
                               LineHeight="18" 
                               Margin="0,0,0,14" />

                    <!-- Hardware Recommendations Box -->
                    <Border Background="#220D10" 
                            BorderBrush="#4D1C21" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,10" 
                            Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Recommended GPU: " FontWeight="SemiBold" FontSize="11.5" Foreground="#FF7B85" />
                                <TextBlock Text="{Binding ModalGpu}" FontWeight="SemiBold" FontSize="11.5" Foreground="#F0F3F6" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Minimum Recommended VRAM: " FontWeight="SemiBold" FontSize="11.5" Foreground="#FF9AA2" />
                                <TextBlock Text="{Binding ModalVram}" FontWeight="Bold" FontSize="11.5" Foreground="#FF424D" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Cancel / Return" 
                                Style="{StaticResource BtnSecondary}" 
                                Height="34" 
                                Command="{Binding ClosePresetModalCommand}" />

                        <Button Grid.Column="2" 
                                Content="Apply Preset" 
                                Style="{StaticResource BtnPrimary}" 
                                Height="34" 
                                Command="{Binding ApplySelectedPresetCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
