<UserControl x:Class="AppUI.Views.PacingTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PacingTuningViewModel}"
             d:DesignHeight="780" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Header with Profile Selector ComboBox -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="AMD Frame Gen (AFMF / FSR-FG) Cadence Alignment" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Tune high-resolution DXGI presentation delays, Anti-Lag 2 synchronization, and FSR frame cadence." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Active Profile Selector ComboBox -->
                <ComboBox ItemsSource="{Binding DataContext.AvailableTuningProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.ActiveTuningProfile, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="GameName"
                          Style="{StaticResource DarkComboBox}"
                          Width="250" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Card 1: Master Pacing & Cadence -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Cadence Control &amp; Anti-Lag 2" Style="{StaticResource TextCardTitle}" Margin="0,0,0,12" />

                    <!-- Enable Pacing Switch -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Enable DXGI Frame Pacer Hook" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Intercepts swapchain presentation calls to enforce uniform frame delivery intervals and stabilize frame times." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Intercepts IDXGISwapChain::Present and meters presentation to match rolling EMA target intervals." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.PacingEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Half-Interval Cadence Switch -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Half-Interval Pacing (FSR)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Ensures generated FSR frames appear precisely halfway between rendered frames (Target = Last + Interval / 2) to eliminate judder." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Calculates TargetPresentTime = LastFrameTime + (EMA / 2) to eliminate micro-stutter on interpolated frames." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.HalfIntervalCadenceEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- AMD Radeon Anti-Lag 2 Switch -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AMD Radeon Anti-Lag 2" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Translates NVIDIA Reflex calls and optimizes CPU-GPU frame submission timing to minimize input lag during frame generation." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="DirectX 12 SDK integration aligning game loop cadence with display presentation deadlines." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.AntiLag2Enabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- HUD Preservation Mask Switch -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HUD Preservation Mask" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Generates a 2D UI isolation mask to prevent fast-moving crosshairs, minimaps, and health bars from smearing during optical flow interpolation." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Protects static and 2D on-screen interface elements from frame interpolation ghosting." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.HudProtection}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 1.5: Multi-Frame Generation Multiplier & Adaptive Target FPS -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Multi-Frame Generation &amp; Adaptive Target FPS" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Multiplier Mode Selector -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Frame Generation Multiplier" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Select fixed multiplier (1x to 6x) or Adaptive mode which dynamically generates intermediate frames up to the configured Target FPS." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Dispatches (N - 1) optical flow interpolated frames between each native game present." 
                                       Style="{StaticResource TextSubheader}" />
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding MultiplierOptions}"
                                  SelectedItem="{Binding ActiveProfile.FrameGenMultiplier}"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="230" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Adaptive Target FPS Slider -->
                    <StackPanel Opacity="{Binding AdaptiveFpsOpacity}" Margin="0,0,0,6">
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Adaptive Target FPS (Cadence Alignment)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="When Multiplier is set to Adaptive, dynamically scales interpolation passes (up to 6x) and waitable timer intervals to match this target." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveProfile.AdaptiveTargetFps, StringFormat={}{0} FPS}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="60" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True" 
                                Value="{Binding ActiveProfile.AdaptiveTargetFps}" IsEnabled="{Binding IsAdaptiveTargetFpsEnabled}" Margin="0,2,0,4" />
                        <TextBlock Text="Recommended: 120 - 240 FPS (Matches display refresh rate for fluid pacing)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Frame Rate Capping & Dynamic EMA Smoothing -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="Frame Rate &amp; Dynamic Smoothing Weights" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Target FPS Cap -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Target FPS Cap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Locks output presentation rate. Set to 0 to automatically follow your display refresh rate or rolling render cadence." />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="0 = Unbounded / Auto EMA cadence" Style="{StaticResource TextSubheader}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="0" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" 
                                Value="{Binding ActiveProfile.TargetFpsCap}" Margin="10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding ActiveProfile.TargetFpsCap, StringFormat={}{0} FPS}" 
                                   Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- EMA Smoothing Alpha with Clean Two-Row Layout -->
                    <StackPanel Margin="0,0,0,6">
                        <!-- Row 1: Header Label + Value & Match Button -->
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="EMA Rolling Window Alpha" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{StaticResource InfoBadge}">
                                    <Border.ToolTip>
                                        <ToolTip Content="Smoothing weight for historical frame times (0.125 = 16-frame window). Lower values resist sudden frame spikes; higher values adapt faster to scene changes.&#x0a;&#x0a;Quick Reference:&#x0a;30-45 FPS: 0.250 | 60 FPS: 0.125 | 90-100 FPS: 0.080 | 120-144 FPS: 0.050 | 165+ FPS: 0.030" />
                                    </Border.ToolTip>
                                    <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ActiveProfile.EmaAlpha, StringFormat={}{0:F3}}" 
                                           Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{StaticResource BtnSecondary}" Content="Match Target FPS" Height="28" Padding="10,2" FontSize="11"
                                        Command="{Binding MatchTargetFpsCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Slider -->
                        <Slider Minimum="0.01" Maximum="0.5" Value="{Binding ActiveProfile.EmaAlpha}" Margin="0,4,12,6" />

                        <!-- Row 2: Recommendation Sub-Label -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Recommended for " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ActiveProfile.TargetFpsCap, StringFormat={}{0} FPS: }" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RecommendedAlphaText}" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: DXGI Presentation & Low Latency Policies -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="SwapChain &amp; Latency Settings" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Force Flip Discard -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Enforce Flip Discard (DXGI_SWAP_EFFECT_FLIP_DISCARD)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Forces low-latency DXGI_SWAP_EFFECT_FLIP_DISCARD, bypassing legacy blit buffers for direct hardware presentation without DWM compositor overhead." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Overrules legacy blit swap effects for minimal presentation latency." Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ModernToggle}" IsChecked="{Binding ActiveProfile.ForceFlipDiscard}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Recommended: Enabled (Bypasses DWM compositor overhead for direct hardware presentation)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Max Frame Latency -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Maximum Frame Latency" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Limits queued back-buffers. 1 frame gives the lowest input lag and prevents frame buffer queue saturation during frame generation." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="1 = lowest latency queue depth" Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="1" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" 
                                    Value="{Binding ActiveProfile.MaxFrameLatency}" Margin="10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding ActiveProfile.MaxFrameLatency, StringFormat={}{0} Frame}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Recommended: 1 Frame (Lowest queue input lag; prevents frame buffering during frame gen)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,14" />

                    <!-- Spin-Yield Microseconds -->
                    <StackPanel Margin="0,0,0,6">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Spin-Yield Precision Window" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InfoBadge}">
                                        <Border.ToolTip>
                                            <ToolTip Content="Microsecond threshold before presentation deadline where the CPU transitions from timer sleep to a fine spin-wait. 500 µs balances precision vs CPU load." />
                                        </Border.ToolTip>
                                        <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Microseconds before deadline to spin-wait" Style="{StaticResource TextSubheader}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="100" Maximum="2000" Value="{Binding ActiveProfile.SpinYieldMicroseconds}" Margin="10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding ActiveProfile.SpinYieldMicroseconds, StringFormat={}{0} µs}" 
                                       Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Recommended: 500 µs (Ideal balance of sub-millisecond pacing precision vs CPU overhead)" FontSize="11" Foreground="#58A6FF" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AMD Red Info Callout -->
            <Border Background="{StaticResource Brush.Callout.Background}" BorderBrush="{StaticResource Brush.Callout.Border}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Glowing Bulb / Info Icon -->
                    <Path Data="M8,1.5 C5,1.5 2.5,3.9 2.5,6.9 C2.5,8.8 3.5,10.4 5,11.3 L5,12.5 C5,12.8 5.2,13 5.5,13 L10.5,13 C10.8,13 11,12.8 11,12.5 L11,11.3 C12.5,10.4 13.5,8.8 13.5,6.9 C13.5,3.9 11,1.5 8,1.5 Z M6,14 L10,14 L10,14.5 C10,14.8 9.8,15 9.5,15 L6.5,15 C6.2,15 6,14.8 6,14.5 Z" Fill="{StaticResource Brush.Callout.Icon}" Grid.Column="0" Height="14" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center" Width="14"/>

                    <!-- Callout Text -->
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Brush.Callout.Text}" Grid.Column="1" Text="AMD Frame Generation creates an interpolated frame between each traditionally rendered frame. If presentation timings fluctuate (e.g., an 8ms frame followed by a 24ms frame), micro-stutter occurs even at high reported FPS. AetherPulse aligns real and generated frames into uniform, evenly spaced delivery intervals for seamless motion smoothness." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
