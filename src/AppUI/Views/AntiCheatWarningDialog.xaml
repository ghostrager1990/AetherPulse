<Window x:Class="AppUI.Views.AntiCheatWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Online Game &amp; Anti-Cheat Notice"
        Height="360" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BgDarkBrush}" 
            BorderBrush="#DA3633" 
            BorderThickness="2" 
            CornerRadius="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" Background="#2F1C1C" BorderBrush="#DA3633" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Online Game &amp; Anti-Cheat Notice" FontSize="16" FontWeight="Bold" Foreground="#F85149" />
                        <TextBlock Text="Potential Anti-Cheat Flag Detection" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Message Card -->
            <Border Grid.Row="1" Background="#161B22" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="This game appears to utilize an online anti-cheat system (e.g. EasyAntiCheat, BattlEye, Vanguard, or Ricochet)." 
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Injecting custom proxy DLLs (version.dll / dxgi.dll / sl.interposer.dll) may trigger false-positive anti-cheat flags or account bans. We strongly recommend using AetherPulse only in offline or single-player modes." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>
            </Border>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnSecondary}" Height="34" Padding="16,6" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button Content="Proceed Anyway (I Understand the Risks)" Style="{StaticResource BtnDanger}" Height="34" Padding="16,6" Click="OnProceedClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
