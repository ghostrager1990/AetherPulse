<Window x:Class="AppUI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AetherPulse"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Width="800"
        Height="450">
    <Grid>
        <Border Background="#0D0E12" ClipToBounds="True" CornerRadius="12">
            <Grid>
                <!-- Splash Artwork -->
                <Image x:Name="SplashImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill"/>

                <!-- Top Edge Progress Track -->
                <Border Background="#161A22" CornerRadius="12,12,0,0" Height="2" VerticalAlignment="Top">
                    <Rectangle Fill="#FF424D" HorizontalAlignment="Left" Width="140">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-140" x:Name="TopPulseTransform"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Duration="0:0:1.2" From="-140" Storyboard.TargetName="TopPulseTransform" Storyboard.TargetProperty="X" To="800"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
