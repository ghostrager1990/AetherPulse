<Window x:Class="AppUI.Views.PerformanceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherPulse Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="340" Height="100"
        Left="24" Top="24">
    <Border Background="#D00A0C10" 
            BorderBrush="#33FF4444" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="AETHERPULSE" 
                           FontWeight="Bold" 
                           FontSize="10" 
                           Foreground="#FF4A4A" 
                           VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" 
                        Background="#2000FF66" 
                        BorderBrush="#8000FF66" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="6,1">
                    <TextBlock x:Name="TxtStatus" 
                               Text="PACING LOCKED" 
                               FontSize="9" 
                               FontWeight="SemiBold" 
                               Foreground="#00FF66" />
                </Border>
            </DockPanel>

            <!-- Main Metrics Row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,4">
                <TextBlock Text="FPS " FontSize="11" Foreground="#888888" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="TxtFps" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0"/>

                <TextBlock Text="FT " FontSize="11" Foreground="#888888" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="TxtFrametime" Text="0.00 ms" FontSize="14" FontWeight="SemiBold" Foreground="#00FFCC" Margin="0,0,12,0" VerticalAlignment="Bottom"/>

                <TextBlock Text="1% " FontSize="11" Foreground="#888888" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="TxtLowFps" Text="0.0" FontSize="14" FontWeight="SemiBold" Foreground="#FFAA00" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- Sub Metrics Row -->
            <DockPanel Grid.Row="2" LastChildFill="False">
                <TextBlock Text="Jitter: " FontSize="10" Foreground="#666666"/>
                <TextBlock x:Name="TxtJitter" Text="0.0%" FontSize="10" FontWeight="Medium" Foreground="#CCCCCC" Margin="0,0,12,0"/>

                <TextBlock Text="Target: " FontSize="10" Foreground="#666666"/>
                <TextBlock x:Name="TxtTarget" Text="Auto" FontSize="10" FontWeight="Medium" Foreground="#CCCCCC"/>

                <TextBlock DockPanel.Dock="Right" Text="Ctrl+Shift+[" FontSize="9" Foreground="#444444" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
