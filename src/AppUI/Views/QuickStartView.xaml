<UserControl x:Class="AppUI.Views.QuickStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AppUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuickStartViewModel}"
             d:DesignHeight="850" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Quick Start Onboarding Guide" Style="{StaticResource TextHeader}" />
                    <TextBlock Text="Get up and running with sub-millisecond frame pacing, FidelityFX ray regeneration, and FSR 4 upscaling in 3 simple steps." 
                               Style="{StaticResource TextSubheader}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 3-Step Walkthrough Card Deck -->
            <Border Style="{StaticResource CardContainer}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Seamless 3-Step Setup Workflow" Style="{StaticResource TextCardTitle}" Margin="0,0,0,16" />

                    <!-- Step 1 Card -->
                    <Border Background="#161B22" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1.5" CornerRadius="21" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#FF424D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Step 1: Add &amp; Deploy Proxy Hooks" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="14" />
                                    <Border Background="#1C2F24" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="One-Click Install" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StatusGreenGlowBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                           Text="Open the Game Library tab, locate your detected game, and click 'Deploy'. AetherPulse automatically copies the dxgi.dll presentation hook and official AMD FidelityFX runtime DLLs directly into the game binaries folder." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Step 2 Card -->
                    <Border Background="#161B22" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1.5" CornerRadius="21" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="2" FontSize="18" FontWeight="Bold" Foreground="#FF424D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Step 2: Enable FSR / FidelityFX In-Game" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="14" />
                                    <Border Background="#201C2F" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="In-Game Menu" FontSize="10" FontWeight="SemiBold" Foreground="#BC8CFF" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                           Text="Launch the game and navigate to Graphics or Video settings. Select FSR / FidelityFX Super Resolution or Native AA. AetherPulse seamlessly intercepts the render passes under the hood, dispatching official AMD FidelityFX Super Resolution, Frame Cadence alignment, and Ray Reconstruction pipelines." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Step 3 Card -->
                    <Border Background="#161B22" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="42" Height="42" Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1.5" CornerRadius="21" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="3" FontSize="18" FontWeight="Bold" Foreground="#FF424D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Step 3: Tune Live Without Restarting" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Hover}" FontSize="14" />
                                    <Border Background="#2F241C" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Zero Restarts" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StatusYellowBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text.Primary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"
                                           Text="Keep AetherPulse open in the background while playing. Adjust RCAS Sharpening, Frame Gen Multipliers (2x–6x or Adaptive), Negative Mipmap LOD Bias, or Wavelet Denoising sliders—all changes serialize live to aetherpulse.ini and take effect instantaneously without restarting the game." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Quick Recommended Profiles Section -->
            <Border Style="{StaticResource CardContainer}">
                <StackPanel>
                    <TextBlock Text="⚡ Quick Recommended Configurations" Style="{StaticResource TextCardTitle}" Margin="0,0,0,14" />

                    <!-- Profile 1: Competitive / High FPS -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎯" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Competitive / High FPS" FontWeight="Bold" Foreground="#FF424D" FontSize="13.5" />
                                <TextBlock Text="Native AA Mode ON + 2x/3x Frame Gen + Anti-Lag 2 ON" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,2" />
                                <TextBlock Text="Best for: Fast-paced shooters, esports titles, and competitive gaming requiring pristine edge clarity and lowest possible input latency." 
                                           FontSize="11.5" Foreground="#FF9AA2" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Profile 2: Path Tracing / Visual Immersion -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✨" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Path Tracing / Visual Immersion" FontWeight="Bold" Foreground="#FF424D" FontSize="13.5" />
                                <TextBlock Text="FSR Quality (67%) + NRC ON + Balanced Denoising + 2x Frame Gen" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,2" />
                                <TextBlock Text="Best for: Heavy ray-traced and path-traced blockbusters (Cyberpunk 2077, Alan Wake 2, Black Myth: Wukong) for flicker-free reflections and rich global illumination." 
                                           FontSize="11.5" Foreground="#FF9AA2" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Profile 3: High Refresh Panel -->
                    <Border Background="#220D10" BorderBrush="#4D1C21" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚀" FontSize="24" Foreground="#FFFFFF" Opacity="1.0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="High Refresh Display (144Hz - 360Hz)" FontWeight="Bold" Foreground="#FF424D" FontSize="13.5" />
                                <TextBlock Text="Adaptive Target FPS Mode set to your display's native refresh rate" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,2,0,2" />
                                <TextBlock Text="Best for: High refresh panels where AetherPulse dynamically scales optical flow passes and waitable timer intervals to lock fluid presentation cadence." 
                                           FontSize="11.5" Foreground="#FF9AA2" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Action Navigation Bar -->
            <Border Background="#12151B" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Ready to configure your first game?" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" />
                        <TextBlock Text="Head over to the Game Library to add your executable and deploy runtime hooks." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Go to Game Library →" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0" 
                            Command="{Binding NavigateToLibraryCommand}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
