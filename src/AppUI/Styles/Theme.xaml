<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AppUI.Converters">

    <!-- Converters -->
    <conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
    <conv:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
    <conv:FrameTimePointsConverter x:Key="FrameTimePointsConverter" GraphWidth="640" GraphHeight="140" MaxFrameTimeMs="33.33" />
    <conv:StringFormatConverter x:Key="StringFormatConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />

    <!-- ========================================================================= -->
    <!-- AMD RADEON TEAM RED PALETTE (COLORS)                                      -->
    <!-- ========================================================================= -->
    <Color x:Key="Color.Accent.Primary">#E01E26</Color>      <!-- Radeon Crimson -->
    <Color x:Key="Color.Accent.Hover">#FF424D</Color>        <!-- Ruby Red -->
    <Color x:Key="Color.Accent.Pressed">#B51218</Color>      <!-- Deep Crimson -->
    <Color x:Key="Color.Accent.Glow">#3A1215</Color>         <!-- Subtle Dark Red Glow -->
    <Color x:Key="Color.Accent.Subtle">#201013</Color>       <!-- Very Subtle Red Surface -->
    
    <Color x:Key="Color.Surface.Background">#0D0E12</Color>  <!-- Deep Gunmetal Charcoal -->
    <Color x:Key="Color.Surface.Sidebar">#08090C</Color>     <!-- Darker Charcoal Sidebar -->
    <Color x:Key="Color.Surface.Card">#15181E</Color>        <!-- Matte Panel Surface -->
    <Color x:Key="Color.Surface.CardHover">#1C2027</Color>   <!-- Card MouseOver -->
    
    <Color x:Key="Color.Border.Default">#272C35</Color>      <!-- Forged Steel Border -->
    <Color x:Key="Color.Border.Active">#E01E26</Color>       <!-- Red Active Border -->
    
    <Color x:Key="Color.Text.Primary">#F0F3F6</Color>        <!-- Crisp Titanium White -->
    <Color x:Key="Color.Text.Secondary">#8B949E</Color>      <!-- Muted Slate -->
    <Color x:Key="Color.Text.Accent">#FF424D</Color>         <!-- Vibrant Red Text Highlight -->
    <Color x:Key="Color.Text.Muted">#555C66</Color>

    <Color x:Key="Color.Status.Green">#238636</Color>
    <Color x:Key="Color.Status.GreenGlow">#3FB950</Color>
    <Color x:Key="Color.Status.Yellow">#D29922</Color>
    <Color x:Key="Color.Callout.Background">#220D10</Color>  <!-- Subtle deep red-tinted backdrop -->
    <Color x:Key="Color.Callout.Border">#4D1C21</Color>      <!-- Rich crimson contour border -->
    <Color x:Key="Color.Callout.Icon">#FF4D58</Color>        <!-- Vibrant red accent icon -->
    <Color x:Key="Color.Callout.Text">#E6EDF3</Color>        <!-- High-contrast crisp silver-white text -->

    <!-- ========================================================================= -->
    <!-- BRUSH TOKENS (ALL SOLIDCOLORBRUSH INSTANCES)                              -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Glow" Color="{StaticResource Color.Accent.Glow}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />

    <SolidColorBrush x:Key="Brush.Surface.Background" Color="{StaticResource Color.Surface.Background}" />
    <SolidColorBrush x:Key="Brush.Surface.Sidebar" Color="{StaticResource Color.Surface.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.CardHover" Color="{StaticResource Color.Surface.CardHover}" />

    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Active" Color="{StaticResource Color.Border.Active}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Accent" Color="{StaticResource Color.Text.Accent}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />

    <SolidColorBrush x:Key="Brush.Callout.Background" Color="{StaticResource Color.Callout.Background}" />
    <SolidColorBrush x:Key="Brush.Callout.Border" Color="{StaticResource Color.Callout.Border}" />
    <SolidColorBrush x:Key="Brush.Callout.Icon" Color="{StaticResource Color.Callout.Icon}" />
    <SolidColorBrush x:Key="Brush.Callout.Text" Color="{StaticResource Color.Callout.Text}" />

    <!-- Legacy / Cross-Compatible Brush Aliases -->
    <SolidColorBrush x:Key="AmdRedBrush" Color="#E10600" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource Color.Surface.Background}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource Color.Surface.Sidebar}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource Color.Surface.CardHover}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Color.Surface.Card}" />

    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource Color.Border.Active}" />

    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="StatusGreenBrush" Color="{StaticResource Color.Status.Green}" />
    <SolidColorBrush x:Key="StatusGreenGlowBrush" Color="{StaticResource Color.Status.GreenGlow}" />
    <SolidColorBrush x:Key="StatusYellowBrush" Color="{StaticResource Color.Status.Yellow}" />
    <SolidColorBrush x:Key="StatusRedBrush" Color="{StaticResource Color.Status.Red}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Color.Text.Muted}" />

    <!-- Typography -->
    <Style TargetType="TextBlock" x:Key="TextHeader">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter, Arial" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TextSubheader">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TextCardTitle">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter, Arial" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Card Container Style -->
    <Style TargetType="Border" x:Key="CardContainer">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style TargetType="Border" x:Key="MetricCard">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Badges -->
    <Style TargetType="Border" x:Key="BadgeRunning">
        <Setter Property="Background" Value="#10261A" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusGreenGlowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style TargetType="Border" x:Key="BadgeMode">
        <Setter Property="Background" Value="#162B3D" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Navigation Rail Button Style -->
    <Style TargetType="Button" x:Key="NavButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="6,3" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter, Arial" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.CardHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Hover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter TargetName="border" Property="BorderThickness" Value="3,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Action Button Style (Radeon Crimson) -->
    <Style TargetType="Button" x:Key="BtnPrimary">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.CardHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button Style -->
    <Style TargetType="Button" x:Key="BtnSecondary">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.CardHover}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button Style -->
    <Style TargetType="Button" x:Key="BtnDanger">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Warning / Conflict Button Style -->
    <Style TargetType="Button" x:Key="BtnWarning">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="#4D2A00" />
        <Setter Property="Foreground" Value="#FFB347" />
        <Setter Property="BorderBrush" Value="#FF9900" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#663800" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#331C00" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info Icon Button / Blurb -->
    <Style TargetType="Border" x:Key="InfoBadge">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- ComboBox ToggleButton Template -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="border" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
                <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.CardHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark ComboBox Style -->
    <Style TargetType="ComboBox" x:Key="DarkComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />
                        <ContentPresenter Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Name="DropDownBorder"
                                    Background="{StaticResource Brush.Surface.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="4">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Implicit ComboBox Style -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}" />

    <!-- Global Dark ToolTip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}"
                                   MaxWidth="300" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window TitleBar Action Buttons -->
    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Surface.CardHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="WindowCloseButton" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Dark TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent.Hover}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Dark Slider Thumb Template -->
    <ControlTemplate x:Key="SliderThumbTemplate" TargetType="Thumb">
        <Ellipse x:Name="thumbEllipse" Width="14" Height="14" Fill="{StaticResource Brush.Text.Primary}" Stroke="{StaticResource Brush.Accent.Primary}" StrokeThickness="2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#E01E26" BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
            </Ellipse.Effect>
        </Ellipse>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumbEllipse" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" />
                <Setter TargetName="thumbEllipse" Property="Stroke" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumbEllipse" Property="Fill" Value="{StaticResource Brush.Accent.Primary}" />
                <Setter TargetName="thumbEllipse" Property="Stroke" Value="#FFFFFF" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Modern Dark Slider -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Accent.Primary}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource SliderThumbTemplate}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource Brush.Border.Default}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern CheckBox Toggle (AMD Crimson Glow) -->
    <Style TargetType="CheckBox" x:Key="ModernToggle">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{StaticResource Brush.Surface.Card}" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Fill="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
                            <Setter TargetName="track" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#E01E26" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="thumb" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- MODERN SLEEK DARK SCROLLBAR SYSTEM                                        -->
    <!-- ========================================================================= -->
    <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="thumbBorder"
                            Background="#2A2D35"
                            CornerRadius="3"
                            Width="6"
                            HorizontalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#FF4A4A"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#E01E26"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="thumbBorder"
                            Background="#2A2D35"
                            CornerRadius="3"
                            Height="6"
                            VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#FF4A4A"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#E01E26"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
        <Setter Property="Foreground" Value="#2A2D35"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="true"
                               IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                <Track x:Name="PART_Track"
                                       IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="false" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="false" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
